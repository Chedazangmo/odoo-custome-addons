<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         FEEDBACK SUMMARY / REPORT VIEWS  (HR/Admin)
    ══════════════════════════════════════════════════════════ -->

    <!-- Pivot view for session analysis -->
    <record id="view_feedback_response_pivot" model="ir.ui.view">
        <field name="name">pms.feedback.response.pivot</field>
        <field name="model">pms.feedback.response</field>
        <field name="arch" type="xml">
            <pivot string="360° Feedback Analysis" sample="1">
                <field name="subject_employee_id" type="row"/>
                <field name="template_id" type="col"/>
                <field name="average_score" type="measure"/>
                <field name="response_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view -->
    <record id="view_feedback_response_graph" model="ir.ui.view">
        <field name="name">pms.feedback.response.graph</field>
        <field name="model">pms.feedback.response</field>
        <field name="arch" type="xml">
            <graph string="360° Feedback Scores" sample="1" type="bar">
                <field name="subject_employee_id"/>
                <field name="average_score" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- HR Admin: All responses overview -->
    <record id="action_feedback_report_admin" model="ir.actions.act_window">
        <field name="name">360° Feedback Reports</field>
        <field name="res_model">pms.feedback.response</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No submitted feedback yet.
            </p>
        </field>
    </record>

</odoo>
