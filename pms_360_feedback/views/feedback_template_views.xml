<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_feedback_template_form" model="ir.ui.view">
        <field name="name">pms.feedback.template.form</field>
        <field name="model">pms.feedback.template</field>
        <field name="arch" type="xml">
            <form string="Feedback Template">
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="pms_360_feedback.group_pms_hr_admin"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state != 'published'"
                            groups="pms_360_feedback.group_pms_hr_admin"/>
                    <button name="action_archive_template" string="Archive" type="object"
                            invisible="state == 'archived'"
                            groups="pms_360_feedback.group_pms_hr_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                groups="pms_360_feedback.group_pms_hr_admin">
                            <field name="session_count" widget="statinfo" string="Sessions"/>
                        </button>
                        <button type="object" class="oe_stat_button" icon="fa-question-circle">
                            <field name="question_count" widget="statinfo" string="Questions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Annual 360 Feedback - Technical Team"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="created_by" readonly="1"/>
                            <field name="active" groups="pms_360_feedback.group_pms_hr_admin"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Describe the purpose of this template..."/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids"
                                   readonly="state == 'published'"
                                   groups="pms_360_feedback.group_pms_hr_admin">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="question_text" string="Question"/>
                                    <field name="question_type" string="Answer Type"/>
                                    <field name="is_required" string="Required"/>
                                    <field name="option_count" string="No. of Options" readonly="1"/>
                                </list>
                                <form string="Question">
                                    <sheet>
                                        <group string="Question Details">
                                            <field name="question_text" string="Question"
                                                   placeholder="e.g. How well does this employee communicate?"/>
                                            <field name="question_type" string="Answer Type"/>
                                            <field name="is_required" string="Required"/>
                                        </group>
                                        <group string="Answer Options"
                                               invisible="question_type == 'text'">
                                            <div class="alert alert-info w-100" role="alert"
                                                 invisible="question_type == 'text'">
                                                <i class="fa fa-info-circle"/>
                                                Add the options employees will choose from below.
                                            </div>
                                            <field name="option_ids" nolabel="1"
                                                   invisible="question_type == 'text'">
                                                <list editable="bottom" open_form_view="False">
                                                    <field name="option_text" string="Option"
                                                           placeholder="e.g. Strongly Agree"/>
                                                </list>
                                            </field>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>


                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_feedback_template_list" model="ir.ui.view">
        <field name="name">pms.feedback.template.list</field>
        <field name="model">pms.feedback.template</field>
        <field name="arch" type="xml">
            <list string="Feedback Templates">
                <field name="name"/>
                <field name="question_count" string="Questions"/>
                <field name="session_count" string="Sessions"/>
                <field name="created_by"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_feedback_template_kanban" model="ir.ui.view">
        <field name="name">pms.feedback.template.kanban</field>
        <field name="model">pms.feedback.template</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="state"/>
                <field name="question_count"/>
                <field name="created_by"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="mt-1">
                                <span class="badge rounded-pill text-bg-secondary">
                                    <field name="question_count"/> Questions
                                </span>
                            </div>
                            <div class="mt-2 text-muted small">
                                By: <field name="created_by"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_feedback_template" model="ir.actions.act_window">
        <field name="name">Feedback Templates</field>
        <field name="res_model">pms.feedback.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first 360 Feedback Template
            </p>
            <p>
                Define questions with radio buttons, checkboxes, or open text answers.
                Once published, HR can create feedback sessions using this template.
            </p>
        </field>
    </record>

</odoo>