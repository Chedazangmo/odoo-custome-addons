<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_feedback_session_form" model="ir.ui.view">
        <field name="name">pms.feedback.session.form</field>
        <field name="model">pms.feedback.session</field>
        <field name="arch" type="xml">
            <form string="Feedback Session">
                <header>
                    <button name="action_open" string="Open Session" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="pms_360_feedback.group_pms_hr_admin"/>
                    <button name="action_close" string="Close Session" type="object"
                            invisible="state != 'open'"
                            groups="pms_360_feedback.group_pms_hr_admin"/>
                    <button name="action_draft" string="Reopen as Draft" type="object"
                            invisible="state not in ('closed', 'cancelled')"
                            groups="pms_360_feedback.group_pms_hr_admin"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('closed', 'cancelled')"
                            groups="pms_360_feedback.group_pms_hr_admin"/>
                    <button name="action_give_feedback" string="Give Feedback" type="object"
                            class="btn-primary"
                            invisible="state != 'open'"
                            groups="pms_360_feedback.group_pms_employee"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_responses" type="object"
                                class="oe_stat_button" icon="fa-comments"
                                groups="pms_360_feedback.group_pms_hr_admin">
                            <field name="response_count" widget="statinfo" string="Responses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="reference" class="text-muted"/>
                        <h6><field name="reference" readonly="1"/></h6>
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Q1 2025 360 Feedback"/></h1>
                    </div>
                    <group>
                        <group string="Session Details">
                            <field name="template_id"
                               readonly="state != 'draft'"
                               options="{'no_create': True}"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                        </group>
                        <group string="Configuration"
                               groups="pms_360_feedback.group_pms_hr_admin">
                            <field name="created_by" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Employees Being Reviewed" name="reviewees"
                              groups="pms_360_feedback.group_pms_hr_admin">
                            <div class="mb-2" invisible="state != 'draft'">
                                <button name="action_select_all_employees"
                                        string="Select All Employees"
                                        type="object"
                                        class="btn btn-secondary me-2"
                                        icon="fa-users"/>
                                <button name="action_clear_reviewees"
                                        string="Clear All"
                                        type="object"
                                        class="btn btn-danger"
                                        icon="fa-trash"
                                        invisible="not reviewee_ids"/>
                            </div>
                            <field name="reviewee_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="name"/>
                                    <field name="job_id"/>
                                    <field name="department_id"/>
                                </list>
                            </field>
                        </page>

                        <page string="Allowed Reviewers (Optional)" name="reviewers"
                              groups="pms_360_feedback.group_pms_hr_admin">
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle"/>
                                Leave empty to allow <strong>all employees</strong> to
                                give feedback. Add specific employees to restrict who
                                can participate.
                            </div>
                            <field name="reviewer_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="name"/>
                                    <field name="job_id"/>
                                    <field name="department_id"/>
                                </list>
                            </field>
                        </page>

                        <page string="Instructions" name="notes">
                            <field name="notes"
                                   placeholder="Provide instructions or context for participants..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_feedback_session_list" model="ir.ui.view">
        <field name="name">pms.feedback.session.list</field>
        <field name="model">pms.feedback.session</field>
        <field name="arch" type="xml">
            <list string="Feedback Sessions">
                <field name="reference"/>
                <field name="name"/>
                <field name="template_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="response_count" string="Responses" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_feedback_session_admin" model="ir.actions.act_window">
        <field name="name">Feedback Sessions</field>
        <field name="res_model">pms.feedback.session</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new Feedback Session</p>
            <p>Select a published template, add employees to review, set dates, and open the session.</p>
        </field>
    </record>

    <record id="action_feedback_session_employee" model="ir.actions.act_window">
        <field name="name">Active Feedback Sessions</field>
        <field name="res_model">pms.feedback.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'open')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No active feedback sessions</p>
            <p>When HR opens a feedback session, it will appear here for you to participate.</p>
        </field>
    </record>

</odoo>