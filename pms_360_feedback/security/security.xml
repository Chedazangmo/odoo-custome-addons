<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups (Odoo 19: category_id removed from res.groups) -->

    <record id="group_pms_hr_admin" model="res.groups">
        <field name="name">PMS HR/Admin</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create/edit feedback templates and sessions, view all responses.</field>
    </record>

    <record id="group_pms_employee" model="res.groups">
        <field name="name">PMS Employee</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can give feedback and view their own received feedback.</field>
    </record>

    <!-- Record Rules -->

    <record id="rule_feedback_template_employee_read" model="ir.rule">
        <field name="name">Feedback Template: Employee Read Published Only</field>
        <field name="model_id" ref="model_pms_feedback_template"/>
        <field name="groups" eval="[(4, ref('group_pms_employee'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">[('state', '=', 'published')]</field>
    </record>

    <record id="rule_feedback_session_employee_read" model="ir.rule">
        <field name="name">Feedback Session: Employee Read Open Only</field>
        <field name="model_id" ref="model_pms_feedback_session"/>
        <field name="groups" eval="[(4, ref('group_pms_employee'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">[('state', '=', 'open')]</field>
    </record>

    <record id="rule_feedback_response_employee" model="ir.rule">
        <field name="name">Feedback Response: Employee Own Records</field>
        <field name="model_id" ref="model_pms_feedback_response"/>
        <field name="groups" eval="[(4, ref('group_pms_employee'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">
            ['|',
              ('reviewer_employee_id.user_id', '=', user.id),
              ('reviewee_employee_id.user_id', '=', user.id)
            ]
        </field>
    </record>

    <record id="rule_feedback_answer_employee" model="ir.rule">
        <field name="name">Feedback Answer: Employee Own Records</field>
        <field name="model_id" ref="model_pms_feedback_answer"/>
        <field name="groups" eval="[(4, ref('group_pms_employee'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
        <field name="domain_force">
            ['|',
              ('response_id.reviewer_employee_id.user_id', '=', user.id),
              ('response_id.reviewee_employee_id.user_id', '=', user.id)
            ]
        </field>
    </record>
</odoo>