<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_appraisal_summary" model="ir.actions.report">
        <field name="name">Appraisal Summary</field>
        <field name="model">pms.appraisal</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">hr_employee_evaluation.report_appraisal_summary_template</field>
        <field name="report_file">hr_employee_evaluation.report_appraisal_summary_template</field>
        <field name="binding_model_id" ref="model_pms_appraisal"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_appraisal_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page px-4">
                        
                        <div class="text-center mb-5">
                            <h2 class="fw-bold">Performance Appraisal Summary</h2>
                            <h4 class="text-muted"><t t-esc="doc.employee_id.name"/></h4>
                        </div>

                        <t t-foreach="doc.kra_ids" t-as="kra">
                            <t t-set="active_kpis" t-value="kra.kpi_ids.filtered(lambda k: k.is_selected)"/>
                            
                            <t t-if="active_kpis">
                                <h4 class="mt-4">
                                    <strong><t t-esc="kra.name"/></strong>
                                </h4>
                                
                                <table class="table table-sm table-bordered mt-3" style="table-layout: fixed; word-wrap: break-word;">
                                    <thead class="bg-light text-uppercase" style="font-size: 12px;">
                                        <tr>
                                            <th style="width: 15%;">KPI Name</th>
                                            <th style="width: 20%;">Criteria</th>
                                            <th style="width: 20%;">Target</th>
                                            <th class="text-center" style="width: 8%;">Score</th>
                                            <th class="text-center" style="width: 9%;">Emp Score</th>
                                            <th class="text-center" style="width: 9%;">Sup Score</th>
                                            <th class="text-center" style="width: 9%;" t-if="doc.secondary_supervisor_id">2nd Sup Score</th>
                                            <th class="text-center" style="width: 10%;" t-if="doc.reviewer_id">Rev Score</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="active_kpis" t-as="kpi">
                                            <tr>
                                                <td class="text-center align-middle fw-600"><t t-esc="kpi.name"/></td>
                                                <td><div style="white-space: pre-wrap; font-size: 0.9rem;"><t t-esc="kpi.criteria"/></div></td>
                                                <td><div style="white-space: pre-wrap; font-size: 0.9rem;"><t t-esc="kpi.target"/></div></td>
                                                
                                                <td class="text-center align-middle"><t t-esc="kpi.weightage"/></td>
                                                <td class="text-center align-middle"><t t-esc="kpi.self_score"/></td>
                                                <td class="text-center align-middle"><t t-esc="kpi.supervisor_score"/></td>
                                                <td class="text-center align-middle" t-if="doc.secondary_supervisor_id"><t t-esc="kpi.secondary_supervisor_score"/></td>
                                                <td class="text-center align-middle fw-bold" t-if="doc.reviewer_id"><t t-esc="kpi.reviewer_score"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>

                        <div class="mt-5 pt-4">
                            <h4>
                                <strong>Total Scores</strong>
                            </h4>
                            <table class="table table-bordered mt-3 shadow-sm">
                                <thead class="bg-light text-uppercase" style="font-size: 13px;">
                                    <tr>
                                        <th class="text-center p-3">Employee Total</th>
                                        <th class="text-center p-3">Supervisor Total</th>
                                        <th class="text-center p-3" t-if="doc.secondary_supervisor_id">2nd Sup Total</th>
                                        <th class="text-center text-white p-3" t-if="doc.reviewer_id">Reviewer Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="text-center fs-5 p-3"><t t-esc="doc.total_self_score"/></td>
                                        <td class="text-center fs-5 p-3"><t t-esc="doc.total_supervisor_score"/></td>
                                        <td class="text-center fs-5 p-3" t-if="doc.secondary_supervisor_id"><t t-esc="doc.total_secondary_score"/></td>
                                        <td class="text-center fs-4 fw-bold text-white p-3" t-if="doc.reviewer_id">
                                            <t t-esc="doc.final_appraisal_score"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>