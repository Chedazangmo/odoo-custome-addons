<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pms_enrollment_wizard_form" model="ir.ui.view">
        <field name="name">pms.enrollment.wizard.form</field>
        <field name="model">pms.enrollment.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Employees">

                <field name="cycle_id" invisible="1"/>
                <field name="has_regular_pending" invisible="1"/>
                <field name="has_probation_pending" invisible="1"/>

                <div class="alert alert-info" role="alert">
                    <i class="fa fa-users me-1"/>
                    Enrolling <strong><field name="pending_summary" class="d-inline"/></strong>
                    employee(s) into this cycle.
                </div>

                <!--
                    Regular late joiner settings.
                    Only shown when there are regular employees pending enrollment.
                    Their personal planning window starts from today.
                -->
                <group string="Regular Employees — Planning Settings"
                       invisible="not has_regular_pending">
                    <field name="planning_duration"
                           string="Planning Duration (Days)"
                           help="Days from today the employee has to submit their plan."/>
                    <field name="resubmission_days"
                           string="Resubmission Days"
                           help="Grace period after HR resets their plan to draft."/>
                </group>

                <!--
                    Probation post-graduation settings.
                    Only shown when there are probation employees pending enrollment.
                    The probation sub-cycle itself is auto-configured:
                      - 10 days planning
                      - 3 months total duration
                      - Last 2 weeks = appraisal phase
                    The fields below apply AFTER probation completes and the employee
                    is automatically enrolled into the regular cycle.
                -->
                <group string="Probation Employees — Post-Probation Settings"
                       invisible="not has_probation_pending">
                    <div class="alert alert-warning mb-3" role="alert">
                        <i class="fa fa-clock-o me-1"/>
                        <strong>Probation cycle is auto-configured:</strong>
                        10 days planning, 3-month duration, last 2 weeks = appraisal.
                        The settings below apply <em>after</em> probation completes and the
                        employee joins the regular cycle.
                    </div>
                    <field name="post_probation_planning_duration"
                           string="Post-Probation Planning Duration (Days)"/>
                    <field name="post_probation_resubmission_days"
                           string="Post-Probation Resubmission Days"/>
                </group>

                <footer>
                    <button name="action_confirm"
                            string="Add Employee"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pms_enrollment_wizard" model="ir.actions.act_window">
        <field name="name">Add Employees</field>
        <field name="res_model">pms.enrollment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>