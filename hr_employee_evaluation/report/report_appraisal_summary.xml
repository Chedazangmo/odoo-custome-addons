<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_appraisal_summary" model="ir.actions.report">
        <field name="name">Appraisal Summary</field>
        <field name="model">pms.appraisal</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">hr_employee_evaluation.report_appraisal_summary_template</field>
        <field name="report_file">hr_employee_evaluation.report_appraisal_summary_template</field>
        <field name="binding_model_id" ref="model_pms_appraisal" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_appraisal_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page px-4">

                        <!-- ══════════════════════════════════════════
                             Header
                        ══════════════════════════════════════════ -->
                        <div class="text-center mb-5">
                            <h2 class="fw-bold">Performance Appraisal Summary</h2>
                            <h4 class="text-muted">
                                <t t-esc="doc.employee_id.name" />
                            </h4>
                        </div>

                        <!-- ══════════════════════════════════════════
                             KRA / KPI Sections
                        ══════════════════════════════════════════ -->
                        <t t-foreach="doc.kra_ids" t-as="kra">
                            <t t-set="active_kpis"
                                t-value="kra.kpi_ids.filtered(lambda k: k.is_selected)" />

                            <t t-if="active_kpis">
                                <h4 class="mt-4">
                                    <strong>
                                        <t t-esc="kra.name" />
                                    </strong>
                                </h4>

                                <table class="table table-sm table-bordered mt-3"
                                    style="table-layout:fixed;word-wrap:break-word;">
                                    <thead class="bg-light text-uppercase" style="font-size:12px;">
                                        <tr>
                                            <th style="width:15%;">KPI Name</th>
                                            <th style="width:20%;">Criteria</th>
                                            <th style="width:20%;">Target</th>
                                            <th class="text-center" style="width:8%;">Score</th>
                                            <th class="text-center" style="width:9%;">Emp Score</th>
                                            <th class="text-center" style="width:9%;">Sup Score</th>
                                            <th class="text-center" style="width:9%;"
                                                t-if="doc.secondary_supervisor_id">2nd Sup Score</th>
                                            <th class="text-center" style="width:10%;"
                                                t-if="doc.reviewer_id">Rev Score</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="active_kpis" t-as="kpi">
                                            <tr>
                                                <td class="align-middle fw-600">
                                                    <t t-esc="kpi.name" />
                                                </td>
                                                <td>
                                                    <div
                                                        style="white-space:pre-wrap;font-size:0.9rem;">
                                                        <t t-esc="kpi.criteria" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div
                                                        style="white-space:pre-wrap;font-size:0.9rem;">
                                                        <t t-esc="kpi.target" />
                                                    </div>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <t t-esc="kpi.weightage" />
                                                </td>
                                                <td class="text-center align-middle">
                                                    <t t-esc="kpi.self_score" />
                                                </td>
                                                <td class="text-center align-middle">
                                                    <t t-esc="kpi.supervisor_score" />
                                                </td>
                                                <td class="text-center align-middle"
                                                    t-if="doc.secondary_supervisor_id">
                                                    <t t-esc="kpi.secondary_supervisor_score" />
                                                </td>
                                                <td class="text-center align-middle fw-bold"
                                                    t-if="doc.reviewer_id">
                                                    <t t-esc="kpi.reviewer_score" />
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>

                        <!-- ══════════════════════════════════════════
                             Competency Framework Section
                             Only shown when the appraisal has competency rows
                        ══════════════════════════════════════════ -->
                        <t t-if="doc.competency_score_ids">

                            <!-- Section heading -->
                            <div class="mt-5 mb-2"
                                style="display:flex;align-items:center;gap:8px;padding-bottom:6px;border-bottom:2px solid #e8a020;">
                                <span style="color:#e8a020;font-size:1em;"></span>
                                <span
                                    style="font-size:1em;font-weight:700;color:#1a3c5e;letter-spacing:0.02em;">
                                    Competency Framework
                                </span>
                            </div>

                            <!-- Group competency rows by group_id for cleaner layout -->
                            <t t-set="comp_rows"
                                t-value="doc.competency_score_ids.sorted(key=lambda r: (r.group_sequence or 0, r.line_sequence or 0))" />

                            <!-- Collect unique group names in order -->
                            <t t-set="seen_groups" t-value="[]" />
                            <t t-foreach="comp_rows" t-as="row">
                                <t t-if="row.group_name not in seen_groups">
                                    <!-- Group sub-heading -->
                                    <h5 class="mt-3 mb-2 text-secondary"
                                        style="font-size:0.95em;font-weight:600;">
                                        <t t-esc="row.group_name" />
                                    </h5>

                                    <table class="table table-sm table-bordered"
                                        style="table-layout:fixed;word-wrap:break-word;">
                                        <thead class="bg-light text-uppercase"
                                            style="font-size:11px;">
                                            <tr>
                                                <th style="width:6%;">Code</th>
                                                <th style="width:20%;">Competency</th>
                                                <th style="width:28%;">Targets</th>
                                                <th class="text-center" style="width:8%;">Max Pts</th>
                                                <th class="text-center" style="width:9%;">Emp Score</th>
                                                <th class="text-center" style="width:9%;">Sup Score</th>
                                                <th class="text-center" style="width:10%;"
                                                    t-if="doc.secondary_supervisor_id">2nd Sup Score</th>
                                                <th class="text-center" style="width:10%;"
                                                    t-if="doc.reviewer_id">Rev Score</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="comp_rows" t-as="crow">
                                                <t t-if="crow.group_name == row.group_name">
                                                    <tr>
                                                        <td class="align-middle"
                                                            style="font-size:0.85rem;">
                                                            <t t-esc="crow.line_full_code or ''" />
                                                        </td>
                                                        <td class="align-middle"
                                                            style="font-size:0.85rem;">
                                                            <t t-esc="crow.line_name or ''" />
                                                        </td>
                                                        <td
                                                            style="white-space:pre-wrap;font-size:0.82rem;color:#555;">
                                                            <t t-esc="crow.line_description or ''" />
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <t
                                                                t-esc="'%.2f' % (crow.line_points or 0)" />
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <t t-esc="crow.self_score or 0" />
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <t t-esc="crow.supervisor_score or 0" />
                                                        </td>
                                                        <t t-if="doc.secondary_supervisor_id">
                                                            <td class="text-center align-middle">
                                                                <t
                                                                    t-esc="crow.secondary_supervisor_score or 0" />
                                                            </td>
                                                        </t>
                                                        <t t-if="doc.reviewer_id">
                                                            <td class="text-center align-middle">
                                                                <t t-esc="crow.reviewer_score or 0" />
                                                            </td>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>

                                    <!-- Mark this group as seen by appending to the list -->
                                    <t t-set="seen_groups" t-value="seen_groups + [row.group_name]" />
                                </t>
                            </t>

                            <!-- Competency sub-totals bar -->
                            <div class="mt-2 mb-4 p-2"
                                style="background:#f0f4ff;border:1px solid #c7d6f5;border-radius:5px;font-size:0.85em;">
                                <strong class="me-3">Competency Totals:</strong>
                                <span class="me-3">Max: <strong>
                                        <t t-esc="'%.2f' % doc.competency_max_total" />
                                    </strong></span>
                                <span class="me-3">Emp: <strong style="color:#1d4ed8;">
                                        <t t-esc="'%.2f' % doc.competency_self_total" />
                                    </strong></span>
                                <span class="me-3" t-if="doc.supervisor_id"> Sup: <strong
                                        style="color:#059669;">
                                        <t t-esc="'%.2f' % doc.competency_supervisor_total" />
                                    </strong>
                                </span>
                                <span class="me-3" t-if="doc.secondary_supervisor_id"> 2nd Sup: <strong
                                        style="color:#d97706;">
                                        <t t-esc="'%.2f' % doc.competency_secondary_total" />
                                    </strong>
                                </span>
                                <span t-if="doc.reviewer_id"> Rev: <strong style="color:#7c3aed;">
                                        <t t-esc="'%.2f' % doc.competency_reviewer_total" />
                                    </strong>
                                </span>
                            </div>

                        </t>
                        <!-- /competency section -->

                        <!-- ══════════════════════════════════════════
                             Grand Total Scores Table
                        ══════════════════════════════════════════ -->
                        <div class="mt-5 pt-4">

                            <div class="d-flex justify-content-between align-items-end mb-2">
                                <h4 class="mb-0">
                                    <strong>Total Scores</strong>
                                </h4>
                                <div class="fs-6 fw-bold text-muted"> Final Score basis: <span
                                        class="text-dark">
                                        <t t-if="doc.cycle_id.final_score_selection == 'average'">Average
                                    of Supervisor Scores</t>
                                        <t t-elif="doc.cycle_id.final_score_selection == 'reviewer'">Reviewer
                                    Score</t>
                                        <t t-else="">Not Set</t>
                                    </span>
                                </div>
                            </div>

                            <!-- Two-part table: KRA row + Competency row + Grand Total row -->
                            <table class="table table-bordered mt-2 shadow-sm">
                                <thead class="bg-light text-uppercase" style="font-size:12px;">
                                    <tr>
                                        <th class="p-2">Component</th>
                                        <th class="text-center p-2">Emp Total</th>
                                        <th class="text-center p-2">Sup Total</th>
                                        <th class="text-center p-2"
                                            t-if="doc.secondary_supervisor_id">2nd Sup Total</th>
                                        <th class="text-center p-2"
                                            t-if="doc.reviewer_id">Rev Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- KRA row -->
                                    <tr>
                                        <td class="fw-bold p-2">KRA / KPI</td>
                                        <td class="text-center p-2">
                                            <t t-esc="'%.2f' % doc.total_self_score" />
                                        </td>
                                        <td class="text-center p-2">
                                            <t t-esc="'%.2f' % doc.total_supervisor_score" />
                                        </td>
                                        <td class="text-center p-2"
                                            t-if="doc.secondary_supervisor_id">
                                            <t t-esc="'%.2f' % doc.total_secondary_score" />
                                        </td>
                                        <td class="text-center p-2"
                                            t-if="doc.reviewer_id">
                                            <t t-esc="'%.2f' % doc.total_reviewer_score" />
                                        </td>
                                    </tr>

                                    <!-- Competency row — only if data exists -->
                                    <t t-if="doc.competency_score_ids">
                                        <tr>
                                            <td class="fw-bold p-2">Competency</td>
                                            <td class="text-center p-2">
                                                <t t-esc="'%.2f' % doc.competency_self_total" />
                                            </td>
                                            <td class="text-center p-2">
                                                <t t-esc="'%.2f' % doc.competency_supervisor_total" />
                                            </td>
                                            <td class="text-center p-2"
                                                t-if="doc.secondary_supervisor_id">
                                                <t t-esc="'%.2f' % doc.competency_secondary_total" />
                                            </td>
                                            <td class="text-center p-2"
                                                t-if="doc.reviewer_id">
                                                <t t-esc="'%.2f' % doc.competency_reviewer_total" />
                                            </td>
                                        </tr>
                                    </t>

                                    <!-- Grand total row -->
                                    <tr class="table-active fw-bold" style="background:#e8f0fe;">
                                        <td class="p-2">Grand Total</td>
                                        <td class="text-center p-2 fs-6">
                                            <t t-esc="'%.2f' % doc.grand_total_self_score" />
                                        </td>
                                        <td class="text-center p-2 fs-6">
                                            <t t-esc="'%.2f' % doc.grand_total_supervisor_score" />
                                        </td>
                                        <td class="text-center p-2 fs-6"
                                            t-if="doc.secondary_supervisor_id">
                                            <t t-esc="'%.2f' % doc.grand_total_secondary_score" />
                                        </td>
                                        <td class="text-center p-2 fs-6"
                                            t-if="doc.reviewer_id">
                                            <t t-esc="'%.2f' % doc.grand_total_reviewer_score" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Final Score highlight -->
                            <div class="text-end mt-3">
                                <span class="fs-5 fw-bold text-dark"
                                    style="border:2px solid #1a3c5e;border-radius:6px;padding:8px 20px;display:inline-block;">
                                    Final Appraisal Score: <span
                                        style="color:#1a3c5e;font-size:1.2em;">
                                        <t t-esc="'%.2f' % doc.final_appraisal_score" />
                                    </span>
                                </span>
                            </div>

                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>