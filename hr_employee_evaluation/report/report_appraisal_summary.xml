<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_appraisal_summary" model="ir.actions.report">
        <field name="name">Appraisal Summary</field>
        <field name="model">pms.appraisal</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">hr_employee_evaluation.report_appraisal_summary_template</field>
        <field name="report_file">hr_employee_evaluation.report_appraisal_summary_template</field>
        <field name="binding_model_id" ref="model_pms_appraisal" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_appraisal_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">

                    <style>
                        @media screen {
                            .print-only-layout { display: none !important; }
                        }
                        @media print {
                            .screen-only-layout { display: none !important; }
                        }

                        .appraisal-export-btn:hover { opacity: 0.88; }

                        /* ── Shared table styles ── */
                        .apr-table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                            word-wrap: break-word;
                            font-size: 11px;
                            margin-bottom: 0;
                        }
                        .apr-table th {
                            background-color: #1a3557;
                            color: #ffffff;
                            padding: 8px 8px;
                            border: 1px solid #1a3557;
                            text-align: center;
                            font-size: 10px;
                            text-transform: uppercase;
                            letter-spacing: 0.04em;
                        }
                        .apr-table th.text-left { text-align: left; }
                        .apr-table td {
                            padding: 7px 8px;
                            border: 1px solid #c5d5ea;
                            vertical-align: top;
                            word-break: break-word;
                            white-space: normal;
                        }
                        .apr-table tr:nth-child(even) td { background-color: #f5f8fd; }
                        .apr-table tr:nth-child(odd) td  { background-color: #ffffff; }
                        .apr-table .kra-cell {
                            font-weight: bold;
                            background-color: #e8f0fb !important;
                            color: #1a3557;
                            vertical-align: middle;
                        }
                        .apr-table .score-center {
                            text-align: center;
                            vertical-align: middle;
                        }
                        .apr-table .subtotal-row td {
                            background-color: #eaf1fb !important;
                            color: #1a3557;
                            font-weight: bold;
                            border-top: 2px solid #2563a8;
                        }
                        .apr-table .total-row td {
                            background-color: #1a3557 !important;
                            color: #ffffff !important;
                            font-weight: bold;
                            font-size: 12px;
                            border-top: 2px solid #0d2b47;
                        }

                        /* ── Keep competency group header + table together ── */
                        .comp-group-block {
                            page-break-inside: avoid;
                            break-inside: avoid;
                        }
                        .comp-group-block h5 {
                            page-break-after: avoid;
                            break-after: avoid;
                            margin-bottom: 4px;
                        }
                    </style>

                    <div class="page px-4 appraisal-summary-report"
                        t-att-id="'appraisal-report-' + str(doc.id)">

                        <t t-set="excel_attachment"
                            t-value="doc.env['ir.attachment'].search([('res_model', '=', 'pms.appraisal'), ('res_id', '=', doc.id), ('name', 'like', 'Appraisal_Summary_%.xlsx')], limit=1, order='id desc')" />

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end mb-4 screen-only-layout">
                            <a href="#" class="appraisal-export-btn"
                                t-att-onclick="'exportAppraisalPDF(event, &quot;appraisal-report-' + str(doc.id) + '&quot;, &quot;Appraisal_Summary_' + (doc.employee_id.name or 'Report') + '.pdf&quot;)'"
                                style="background-color:#dc3545;color:#ffffff;border:none;padding:10px 18px;border-radius:6px;font-weight:600;text-decoration:none;margin-right:10px;display:inline-flex;align-items:center;cursor:pointer;">
                                <i class="fa fa-file-pdf-o me-2"></i> Export PDF
                            </a>
                            <a t-if="excel_attachment"
                                t-attf-href="/web/content/#{excel_attachment.id}?download=true"
                                style="background-color:#198754;color:#ffffff;border:none;padding:10px 18px;border-radius:6px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;">
                                <i class="fa fa-file-excel-o me-2"></i> Export Excel
                            </a>
                        </div>

                        <!-- Report Header -->
                        <div style="background:#1a3557;color:#fff;padding:14px 20px;text-align:center;margin-bottom:4px;">
                            <div style="font-size:17px;font-weight:bold;">Performance Appraisal Summary</div>
                            <div style="font-size:13px;color:#aecde8;margin-top:4px;">
                                <t t-esc="doc.employee_id.name" />
                                <t t-if="doc.employee_department_id">
                                    — <t t-esc="doc.employee_department_id.name" />
                                </t>
                            </div>
                        </div>
                       <div style="background:#2563a8;color:#fff;display:flex;justify-content:space-around;padding:7px 20px;margin-bottom:16px;">
    <div style="text-align:center;">
        <div style="font-size:9px;color:#aecde8;">Cycle</div>
        <div style="font-size:11px;font-weight:bold;"><t t-esc="doc.cycle_id.name or '-'" /></div>
    </div>
    <div style="text-align:center;">
        <div style="font-size:9px;color:#aecde8;">Start Date</div>
        <div style="font-size:11px;font-weight:bold;"><t t-esc="str(doc.cycle_id.start_date) if doc.cycle_id.start_date else '-'" /></div>
    </div>
    <div style="text-align:center;">
        <div style="font-size:9px;color:#aecde8;">End Date</div>
        <div style="font-size:11px;font-weight:bold;"><t t-esc="str(doc.cycle_id.end_date) if doc.cycle_id.end_date else '-'" /></div>
    </div>
    <div style="text-align:center;">
        <div style="font-size:9px;color:#aecde8;">Supervisor</div>
        <div style="font-size:11px;font-weight:bold;"><t t-esc="doc.supervisor_id.name or '-'" /></div>
    </div>
    <div t-if="doc.secondary_supervisor_id" style="text-align:center;">
        <div style="font-size:9px;color:#aecde8;">Secondary</div>
        <div style="font-size:11px;font-weight:bold;"><t t-esc="doc.secondary_supervisor_id.name" /></div>
    </div>
    <div t-if="doc.reviewer_id" style="text-align:center;">
        <div style="font-size:9px;color:#aecde8;">Reviewer</div>
        <div style="font-size:11px;font-weight:bold;"><t t-esc="doc.reviewer_id.name" /></div>
    </div>
    <div style="text-align:center;">
        <div style="font-size:9px;color:#aecde8;">Status</div>
        <div style="font-size:11px;font-weight:bold;"><t t-esc="dict(doc._fields['state'].selection).get(doc.state, doc.state)" /></div>
    </div>
    <div style="text-align:center;">
        <div style="font-size:9px;color:#aecde8;">Final Score</div>
        <div style="font-size:13px;font-weight:bold;color:#ffd700;">
            <t t-esc="'%.2f' % doc.final_appraisal_score" />
        </div>
    </div>
</div>

                        <!-- ══════════════════════════════════════════
                             SCREEN LAYOUT
                        ══════════════════════════════════════════ -->
                        <div class="screen-only-layout">

                            <!-- KPI Section header -->
                            <div style="background:#2563a8;color:#fff;padding:7px 12px;font-size:12px;font-weight:bold;margin-bottom:8px;">
                                KPI / KRA Scores
                            </div>

                            <t t-foreach="doc.kra_ids" t-as="kra">
                                <t t-set="active_kpis" t-value="kra.kpi_ids.filtered(lambda k: k.is_selected)" />
                                <t t-if="active_kpis">
                                    <h5 style="margin-top:16px;margin-bottom:6px;color:#1a3557;font-weight:700;border-left:4px solid #2563a8;padding-left:8px;">
                                        <t t-esc="kra.name" />
                                    </h5>
                                    <table class="apr-table">
                                        <thead>
                                            <tr>
                                                <th class="text-left" style="width:16%;">KPI Name</th>
                                                <th class="text-left" style="width:20%;">Criteria</th>
                                                <th class="text-left" style="width:20%;">Target</th>
                                                <th style="width:8%;">Max</th>
                                                <th style="width:9%;">Self</th>
                                                <th style="width:9%;">Supervisor</th>
                                                <th style="width:9%;" t-if="doc.secondary_supervisor_id">Secondary</th>
                                                <th style="width:9%;" t-if="doc.reviewer_id">Reviewer</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="active_kpis" t-as="kpi">
                                                <tr>
                                                    <td style="font-weight:600;vertical-align:middle;"><t t-esc="kpi.name" /></td>
                                                    <td><t t-esc="(kpi.criteria or '').strip()" /></td>
                                                    <td><t t-esc="(kpi.target or '').strip()" /></td>
                                                    <td class="score-center"><t t-esc="kpi.weightage" /></td>
                                                    <td class="score-center"><t t-esc="kpi.self_score or 0" /></td>
                                                    <td class="score-center"><t t-esc="kpi.supervisor_score or 0" /></td>
                                                    <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="kpi.secondary_supervisor_score or 0" /></td>
                                                    <td class="score-center fw-bold" t-if="doc.reviewer_id"><t t-esc="kpi.reviewer_score or 0" /></td>
                                                </tr>
                                            </t>
                                            <!-- KRA subtotal -->
                                            <tr class="subtotal-row">
                                                <td colspan="3" style="text-align:right;">KRA Subtotal</td>
                                                <td class="score-center"><t t-esc="'%.2f' % sum(active_kpis.mapped('weightage'))" /></td>
                                                <td class="score-center"><t t-esc="'%.2f' % sum(active_kpis.mapped('self_score'))" /></td>
                                                <td class="score-center"><t t-esc="'%.2f' % sum(active_kpis.mapped('supervisor_score'))" /></td>
                                                <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="'%.2f' % sum(active_kpis.mapped('secondary_supervisor_score'))" /></td>
                                                <td class="score-center" t-if="doc.reviewer_id"><t t-esc="'%.2f' % sum(active_kpis.mapped('reviewer_score'))" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                            </t>

                            <!-- KPI Grand Total -->
                            <table class="apr-table" style="margin-top:4px;margin-bottom:16px;">
                                <tbody>
                                    <tr class="total-row">
                                        <td colspan="3" style="text-align:right;width:44%;">KPI Total</td>
                                        <td class="score-center" style="width:8%;"><t t-esc="'%.2f' % doc.planning_total_score" /></td>
                                        <td class="score-center" style="width:9%;"><t t-esc="'%.2f' % doc.total_self_score" /></td>
                                        <td class="score-center" style="width:9%;"><t t-esc="'%.2f' % doc.total_supervisor_score" /></td>
                                        <td class="score-center" style="width:9%;" t-if="doc.secondary_supervisor_id"><t t-esc="'%.2f' % doc.total_secondary_score" /></td>
                                        <td class="score-center" style="width:9%;" t-if="doc.reviewer_id"><t t-esc="'%.2f' % doc.total_reviewer_score" /></td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Competency Section -->
                            <t t-if="doc.competency_score_ids">
                                <div style="background:#2563a8;color:#fff;padding:7px 12px;font-size:12px;font-weight:bold;margin-top:16px;margin-bottom:8px;">
                                    Competency Scores
                                </div>

                                <t t-set="comp_rows" t-value="doc.competency_score_ids.sorted(key=lambda r: (r.group_sequence or 0, r.line_sequence or 0))" />
                                <t t-set="seen_groups" t-value="[]" />

                                <t t-foreach="comp_rows" t-as="row">
                                    <t t-if="row.group_name not in seen_groups">
                                        <div class="comp-group-block">
                                            <h5 style="margin-top:14px;margin-bottom:4px;color:#1a3557;font-weight:700;border-left:4px solid #e8a020;padding-left:8px;">
                                                <t t-esc="row.group_name" />
                                            </h5>
                                            <table class="apr-table">
                                                <thead>
                                                    <tr>
                                                        <th class="text-left" style="width:7%;">Code</th>
                                                        <th class="text-left" style="width:20%;">Competency</th>
                                                        <th class="text-left" style="width:28%;">Targets</th>
                                                        <th style="width:8%;">Max Pts</th>
                                                        <th style="width:9%;">Self</th>
                                                        <th style="width:9%;">Supervisor</th>
                                                        <th style="width:9%;" t-if="doc.secondary_supervisor_id">Secondary</th>
                                                        <th style="width:10%;" t-if="doc.reviewer_id">Reviewer</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="comp_rows" t-as="crow">
                                                        <t t-if="crow.group_name == row.group_name">
                                                            <tr>
                                                                <td style="font-size:0.85rem;vertical-align:middle;"><t t-esc="crow.line_full_code or ''" /></td>
                                                                <td style="font-size:0.85rem;vertical-align:middle;"><t t-esc="crow.line_name or ''" /></td>
                                                                <td style="font-size:0.82rem;color:#555;"><t t-esc="(crow.line_description or '').strip()" /></td>
                                                                <td class="score-center"><t t-esc="'%.2f' % (crow.line_points or 0)" /></td>
                                                                <td class="score-center"><t t-esc="crow.self_score or 0" /></td>
                                                                <td class="score-center"><t t-esc="crow.supervisor_score or 0" /></td>
                                                                <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="crow.secondary_supervisor_score or 0" /></td>
                                                                <td class="score-center" t-if="doc.reviewer_id"><t t-esc="crow.reviewer_score or 0" /></td>
                                                            </tr>
                                                        </t>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                        <t t-set="seen_groups" t-value="seen_groups + [row.group_name]" />
                                    </t>
                                </t>

                                <!-- Competency Total -->
                                <table class="apr-table" style="margin-top:4px;margin-bottom:16px;">
                                    <tbody>
                                        <tr class="total-row">
                                            <td colspan="3" style="text-align:right;width:55%;">Competency Total</td>
                                            <td class="score-center" style="width:8%;"><t t-esc="'%.2f' % doc.competency_max_total" /></td>
                                            <td class="score-center" style="width:9%;"><t t-esc="'%.2f' % doc.competency_self_total" /></td>
                                            <td class="score-center" style="width:9%;"><t t-esc="'%.2f' % doc.competency_supervisor_total" /></td>
                                            <td class="score-center" style="width:9%;" t-if="doc.secondary_supervisor_id"><t t-esc="'%.2f' % doc.competency_secondary_total" /></td>
                                            <td class="score-center" style="width:10%;" t-if="doc.reviewer_id"><t t-esc="'%.2f' % doc.competency_reviewer_total" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>


                            <div style="margin-top:20px;page-break-inside:avoid;">
                                <div style="background:#1a3557;color:#fff;padding:7px 12px;font-size:12px;font-weight:bold;margin-bottom:0;">
                                    Grand Total Summary
                                </div>
                                <table class="apr-table">
                                    <thead>
                                        <tr>
                                            <th class="text-left" style="width:30%;">Component</th>
                                            <th style="width:14%;">Max</th>
                                            <th style="width:14%;">Emp Total</th>
                                            <th style="width:14%;">Sup Total</th>
                                            <th style="width:14%;" t-if="doc.secondary_supervisor_id">2nd Sup Total</th>
                                            <th style="width:14%;" t-if="doc.reviewer_id">Rev Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="font-weight:600;">KPI / KRA</td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.planning_total_score" /></td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.total_self_score" /></td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.total_supervisor_score" /></td>
                                            <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="'%.2f' % doc.total_secondary_score" /></td>
                                            <td class="score-center" t-if="doc.reviewer_id"><t t-esc="'%.2f' % doc.total_reviewer_score" /></td>
                                        </tr>
                                        <t t-if="doc.competency_score_ids">
                                            <tr>
                                                <td style="font-weight:600;">Competency</td>
                                                <td class="score-center"><t t-esc="'%.2f' % doc.competency_max_total" /></td>
                                                <td class="score-center"><t t-esc="'%.2f' % doc.competency_self_total" /></td>
                                                <td class="score-center"><t t-esc="'%.2f' % doc.competency_supervisor_total" /></td>
                                                <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="'%.2f' % doc.competency_secondary_total" /></td>
                                                <td class="score-center" t-if="doc.reviewer_id"><t t-esc="'%.2f' % doc.competency_reviewer_total" /></td>
                                            </tr>
                                        </t>
                                        <tr class="total-row">
    <td>Total</td>
    <td class="score-center">
        <t t-esc="'%.2f' % (doc.planning_total_score + doc.competency_max_total)" />
    </td>
    <td class="score-center"><t t-esc="'%.2f' % doc.grand_total_self_score" /></td>
    <td class="score-center"><t t-esc="'%.2f' % doc.grand_total_supervisor_score" /></td>
    <td class="score-center" t-if="doc.secondary_supervisor_id">
        <t t-esc="'%.2f' % doc.grand_total_secondary_score" />
    </td>
    <td class="score-center" t-if="doc.reviewer_id">
        <t t-esc="'%.2f' % doc.grand_total_reviewer_score" />
    </td>
</tr>
                                    </tbody>
                                </table>

                                <div style="text-align:right;margin-top:12px;">
                                    <span style="border:2px solid #1a3557;border-radius:6px;padding:8px 20px;display:inline-block;font-weight:bold;font-size:14px;">
                                        Final Score basis:
                                        <t t-if="doc.cycle_id.final_score_selection == 'average'">Average of Supervisor Scores</t>
                                        <t t-elif="doc.cycle_id.final_score_selection == 'reviewer'">Reviewer Score</t>
                                        <t t-else="">Not Set</t>
                                        — <span style="color:#1a3557;font-size:1.2em;">
                                            <t t-esc="'%.2f' % doc.final_appraisal_score" />
                                        </span>
                                    </span>
                                </div>
                            </div>

                        </div>

                        <!-- ══════════════════════════════════════════
                             PRINT LAYOUT (used by html2pdf)
                        ══════════════════════════════════════════ -->
                        <div class="print-only-layout">

                            <!-- KPI flat table -->
                            <div style="background:#2563a8;color:#fff;padding:6px 10px;font-size:11px;font-weight:bold;margin-bottom:0;">KPI / KRA Scores</div>
                            <table class="apr-table">
                                <thead>
                                    <tr>
                                        <th class="text-left" style="width:11%;">KRA</th>
                                        <th class="text-left" style="width:13%;">KPI</th>
                                        <th class="text-left" style="width:17%;">Criteria</th>
                                        <th class="text-left" style="width:17%;">Target</th>
                                        <th style="width:6%;">Max</th>
                                        <th style="width:7%;">Self</th>
                                        <th style="width:7%;">Supervisor</th>
                                        <th style="width:7%;" t-if="doc.secondary_supervisor_id">Secondary</th>
                                        <th style="width:7%;" t-if="doc.reviewer_id">Reviewer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.kra_ids" t-as="kra">
                                        <t t-set="active_kpis" t-value="kra.kpi_ids.filtered(lambda k: k.is_selected)" />
                                        <t t-foreach="active_kpis" t-as="kpi">
                                            <tr>
                                                <td class="kra-cell"><t t-esc="kra.name" /></td>
                                                <td style="font-weight:600;vertical-align:middle;"><t t-esc="kpi.name" /></td>
                                                <td><t t-esc="(kpi.criteria or '').strip()" /></td>
                                                <td><t t-esc="(kpi.target or '').strip()" /></td>
                                                <td class="score-center"><t t-esc="kpi.weightage" /></td>
                                                <td class="score-center"><t t-esc="kpi.self_score or 0" /></td>
                                                <td class="score-center"><t t-esc="kpi.supervisor_score or 0" /></td>
                                                <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="kpi.secondary_supervisor_score or 0" /></td>
                                                <td class="score-center" t-if="doc.reviewer_id"><t t-esc="kpi.reviewer_score or 0" /></td>
                                            </tr>
                                        </t>
                                    </t>
                                    <!-- KPI total row -->
                                    <tr class="total-row">
                                        <td colspan="4" style="text-align:right;">KPI Total</td>
                                        <td class="score-center"><t t-esc="'%.2f' % doc.planning_total_score" /></td>
                                        <td class="score-center"><t t-esc="'%.2f' % doc.total_self_score" /></td>
                                        <td class="score-center"><t t-esc="'%.2f' % doc.total_supervisor_score" /></td>
                                        <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="'%.2f' % doc.total_secondary_score" /></td>
                                        <td class="score-center" t-if="doc.reviewer_id"><t t-esc="'%.2f' % doc.total_reviewer_score" /></td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Competency flat table -->
                            <t t-if="doc.competency_score_ids">
                                <div style="background:#2563a8;color:#fff;padding:6px 10px;font-size:11px;font-weight:bold;margin-top:14px;margin-bottom:0;">Competency Scores</div>
                                <table class="apr-table">
                                    <thead>
                                        <tr>
                                            <th class="text-left" style="width:8%;">Group</th>
                                            <th class="text-left" style="width:6%;">Code</th>
                                            <th class="text-left" style="width:18%;">Competency</th>
                                            <th class="text-left" style="width:26%;">Targets</th>
                                            <th style="width:7%;">Max</th>
                                            <th style="width:7%;">Self</th>
                                            <th style="width:7%;">Supervisor</th>
                                            <th style="width:7%;" t-if="doc.secondary_supervisor_id">Secondary</th>
                                            <th style="width:7%;" t-if="doc.reviewer_id">Reviewer</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="comp_rows_print" t-value="doc.competency_score_ids.sorted(key=lambda r: (r.group_sequence or 0, r.line_sequence or 0))" />
                                        <t t-foreach="comp_rows_print" t-as="crow">
                                            <tr>
                                                <td class="kra-cell" style="font-size:10px;"><t t-esc="crow.group_name or ''" /></td>
                                                <td style="font-size:10px;vertical-align:middle;"><t t-esc="crow.line_full_code or ''" /></td>
                                                <td style="font-size:10px;vertical-align:middle;"><t t-esc="crow.line_name or ''" /></td>
                                                <td style="font-size:10px;color:#444;"><t t-esc="(crow.line_description or '').strip()" /></td>
                                                <td class="score-center"><t t-esc="'%.2f' % (crow.line_points or 0)" /></td>
                                                <td class="score-center"><t t-esc="crow.self_score or 0" /></td>
                                                <td class="score-center"><t t-esc="crow.supervisor_score or 0" /></td>
                                                <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="crow.secondary_supervisor_score or 0" /></td>
                                                <td class="score-center" t-if="doc.reviewer_id"><t t-esc="crow.reviewer_score or 0" /></td>
                                            </tr>
                                        </t>
                                        <!-- Competency total row -->
                                        <tr class="total-row">
                                            <td colspan="4" style="text-align:right;">Competency Total</td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.competency_max_total" /></td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.competency_self_total" /></td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.competency_supervisor_total" /></td>
                                            <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="'%.2f' % doc.competency_secondary_total" /></td>
                                            <td class="score-center" t-if="doc.reviewer_id"><t t-esc="'%.2f' % doc.competency_reviewer_total" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>

                            <!-- Grand total summary table -->
                            <div style="margin-top:14px;">
                                <div style="background:#1a3557;color:#fff;padding:6px 10px;font-size:11px;font-weight:bold;margin-bottom:0;">Grand Total Summary</div>
                                <table class="apr-table">
                                    <thead>
                                        <tr>
                                            <th class="text-left" style="width:30%;">Component</th>
                                            <th style="width:14%;">Max</th>
                                            <th style="width:14%;">Self</th>
                                            <th style="width:14%;">Supervisor</th>
                                            <th style="width:14%;" t-if="doc.secondary_supervisor_id">Secondary</th>
                                            <th style="width:14%;" t-if="doc.reviewer_id">Rev</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="font-weight:600;">KPI / KRA</td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.planning_total_score" /></td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.total_self_score" /></td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.total_supervisor_score" /></td>
                                            <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="'%.2f' % doc.total_secondary_score" /></td>
                                            <td class="score-center" t-if="doc.reviewer_id"><t t-esc="'%.2f' % doc.total_reviewer_score" /></td>
                                        </tr>
                                        <t t-if="doc.competency_score_ids">
                                            <tr>
                                                <td style="font-weight:600;">Competency</td>
                                                <td class="score-center"><t t-esc="'%.2f' % doc.competency_max_total" /></td>
                                                <td class="score-center"><t t-esc="'%.2f' % doc.competency_self_total" /></td>
                                                <td class="score-center"><t t-esc="'%.2f' % doc.competency_supervisor_total" /></td>
                                                <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="'%.2f' % doc.competency_secondary_total" /></td>
                                                <td class="score-center" t-if="doc.reviewer_id"><t t-esc="'%.2f' % doc.competency_reviewer_total" /></td>
                                            </tr>
                                        </t>
                                        <tr class="total-row">
                                            <td>Grand Total</td>
                                            <td class="score-center">—</td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.grand_total_self_score" /></td>
                                            <td class="score-center"><t t-esc="'%.2f' % doc.grand_total_supervisor_score" /></td>
                                            <td class="score-center" t-if="doc.secondary_supervisor_id"><t t-esc="'%.2f' % doc.grand_total_secondary_score" /></td>
                                            <td class="score-center" t-if="doc.reviewer_id"><t t-esc="'%.2f' % doc.grand_total_reviewer_score" /></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div style="text-align:right;margin-top:10px;font-weight:bold;font-size:13px;">
                                    Final Score:
                                    <t t-if="doc.cycle_id.final_score_selection == 'average'">Average of Supervisor Scores</t>
                                    <t t-elif="doc.cycle_id.final_score_selection == 'reviewer'">Reviewer Score</t>
                                    <t t-else="">Not Set</t>
                                    — <span style="color:#1a3557;font-size:1.3em;">
                                        <t t-esc="'%.2f' % doc.final_appraisal_score" />
                                    </span>
                                </div>
                            </div>

                        </div>

                    </div>

                    <script type="text/javascript"
                        src="/hr_employee_evaluation/static/lib/html2pdf.bundle.min.js">
                    </script>

                    <script type="text/javascript">
                        function exportAppraisalPDF(e, containerId, filename) {
                            e.preventDefault();
                            var container = document.getElementById(containerId);
                            if (!container) { alert('Report content not found.'); return; }

                            var screenLayouts = container.querySelectorAll('.screen-only-layout');
                            var printLayouts  = container.querySelectorAll('.print-only-layout');

                            screenLayouts.forEach(function(el) { el.style.setProperty('display', 'none', 'important'); });
                            printLayouts.forEach(function(el)  { el.style.setProperty('display', 'block', 'important'); });

                            var opt = {
                                margin:      [10, 8, 10, 8],
                                filename:    filename || 'Appraisal_Summary.pdf',
                                image:       { type: 'jpeg', quality: 0.98 },
                                html2canvas: { scale: 2, useCORS: true, logging: false, scrollY: 0 },
                                jsPDF:       { unit: 'mm', format: 'a4', orientation: 'landscape' },
                                pagebreak:   { mode: ['avoid-all', 'css', 'legacy'] }
                            };

                            html2pdf()
                                .set(opt)
                                .from(container)
                                .save()
                                .then(function() {
                                    screenLayouts.forEach(function(el) { el.style.removeProperty('display'); });
                                    printLayouts.forEach(function(el)  { el.style.removeProperty('display'); });
                                });
                        }
                    </script>

                </t>
            </t>
        </t>
    </template>

</odoo>