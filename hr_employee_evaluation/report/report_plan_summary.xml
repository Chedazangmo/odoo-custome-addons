<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_plan_summary" model="ir.actions.report">
        <field name="name">Plan Summary</field>
        <field name="model">pms.appraisal</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">hr_employee_evaluation.report_plan_summary_template</field>
        <field name="report_file">hr_employee_evaluation.report_plan_summary_template</field>
        <field name="binding_model_id" ref="model_pms_appraisal" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_plan_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">

                    <style>
                        @media screen {
                            .print-only-layout { display: none !important; }
                        }
                        @media print {
                            .screen-only-layout { display: none !important; }
                        }
                    </style>

                    <div class="page px-4 appraisal-summary-report">

                        <t t-set="excel_attachment"
                            t-value="doc.env['ir.attachment'].search([('res_model', '=', 'pms.appraisal'), ('res_id', '=', doc.id), ('name', 'like', 'Plan_Summary_%.xlsx')], limit=1, order='id desc')" />

                        <div class="d-flex justify-content-end mb-4 screen-only-layout">
                            <a
                                t-attf-href="/report/pdf/hr_employee_evaluation.report_plan_summary_template/#{doc.id}"
                                style="background-color: #dc3545; color: #ffffff; border: none; padding: 10px 18px; border-radius: 6px; font-weight: 600; text-decoration: none; margin-right: 10px; display: inline-flex; align-items: center;">
                                <i class="fa fa-file-pdf-o me-2"></i> Export PDF </a>
                            <a t-if="excel_attachment"
                                t-attf-href="/web/content/#{excel_attachment.id}?download=true"
                                style="background-color: #198754; color: #ffffff; border: none; padding: 10px 18px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center;">
                                <i class="fa fa-file-excel-o me-2"></i> Export Excel </a>
                        </div>

                        <div class="text-center mb-5">
                            <h2 class="fw-bold">Performance Plan Summary</h2>
                            <h4 class="text-muted">
                                <t t-esc="doc.employee_id.name" />
                            </h4>
                        </div>

                        <div class="screen-only-layout">
                            <t t-foreach="doc.kra_ids" t-as="kra">
                                <t t-set="active_kpis"
                                    t-value="kra.kpi_ids.filtered(lambda k: k.is_selected)" />
                                <t t-if="active_kpis">
                                    <h4 class="kra-title mt-4">
                                        <strong>
                                            <t t-esc="kra.name" />
                                        </strong>
                                    </h4>
                                    <table class="table table-sm table-bordered kpi-table mt-3"
                                        style="table-layout: fixed; word-wrap: break-word;">
                                        <thead class="bg-light text-uppercase"
                                            style="font-size: 12px;">
                                            <tr>
                                                <th style="width: 20%;">KPI Name</th>
                                                <th style="width: 20%;">Description</th>
                                                <th style="width: 25%;">Criteria</th>
                                                <th style="width: 25%;">Target</th>
                                                <th class="text-center" style="width: 10%;">Score</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="active_kpis" t-as="kpi">
                                                <tr>
                                                    <td class="text-center align-middle fw-600">
                                                        <t t-esc="kpi.name" />
                                                    </td>
                                                    <td>
                                                        <div
                                                            style="white-space: pre-wrap; font-size: 0.9rem;">
                                                            <t t-esc="kpi.description" />
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div
                                                            style="white-space: pre-wrap; font-size: 0.9rem;">
                                                            <t t-esc="kpi.criteria" />
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div
                                                            style="white-space: pre-wrap; font-size: 0.9rem;">
                                                            <t t-esc="kpi.target" />
                                                        </div>
                                                    </td>
                                                    <td class="text-center align-middle">
                                                        <t t-esc="kpi.weightage" />
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                            </t>
                        </div>

                        <div class="print-only-layout">
                            <table class="table table-sm table-bordered mt-3"
                                style="table-layout: fixed; word-wrap: break-word; page-break-inside: auto;">
                                <thead class="bg-light text-uppercase" style="font-size: 12px;">
                                    <tr>
                                        <th style="width: 15%;">KRA Name</th>
                                        <th style="width: 15%;">KPI Name</th>
                                        <th style="width: 20%;">Description</th>
                                        <th style="width: 25%;">Criteria</th>
                                        <th style="width: 15%;">Target</th>
                                        <th class="text-center" style="width: 10%;">Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.kra_ids" t-as="kra">
                                        <t t-set="active_kpis"
                                            t-value="kra.kpi_ids.filtered(lambda k: k.is_selected)" />
                                        <t t-foreach="active_kpis" t-as="kpi">
                                            <tr>
                                                <td class="align-middle fw-bold bg-light">
                                                    <t t-esc="kra.name" />
                                                </td>
                                                <td class="align-middle fw-600">
                                                    <t t-esc="kpi.name" />
                                                </td>
                                                <td>
                                                    <div
                                                        style="white-space: pre-wrap; font-size: 0.9rem;">
                                                        <t t-esc="kpi.description" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div
                                                        style="white-space: pre-wrap; font-size: 0.9rem;">
                                                        <t t-esc="kpi.criteria" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <div
                                                        style="white-space: pre-wrap; font-size: 0.9rem;">
                                                        <t t-esc="kpi.target" />
                                                    </div>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <t t-esc="kpi.weightage" />
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>