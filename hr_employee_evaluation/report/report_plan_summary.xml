<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_plan_summary" model="ir.actions.report">
        <field name="name">Plan Summary</field>
        <field name="model">pms.appraisal</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">hr_employee_evaluation.report_plan_summary_template</field>
        <field name="report_file">hr_employee_evaluation.report_plan_summary_template</field>
        <field name="binding_model_id" ref="model_pms_appraisal" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_plan_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">

                    <style>
                        @media screen {
                            .print-only-layout { display: none !important; }
                        }
                        @media print {
                            .screen-only-layout { display: none !important; }
                        }
                        .plan-report-table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                            word-wrap: break-word;
                            font-size: 12px;
                        }
                        .plan-report-table th {
                            background-color: #1a3557;
                            color: #ffffff;
                            padding: 8px 10px;
                            border: 1px solid #1a3557;
                            text-align: left;
                            font-size: 11px;
                            text-transform: uppercase;
                            letter-spacing: 0.04em;
                        }
                        .plan-report-table td {
                            padding: 7px 10px;
                            border: 1px solid #c5d5ea;
                            vertical-align: top;
                            font-size: 11px;
                            word-break: break-word;
                            white-space: pre-wrap;
                        }
                        .plan-report-table tr:nth-child(even) td { background-color: #f5f8fd; }
                        .plan-report-table tr:nth-child(odd) td  { background-color: #ffffff; }
                        .plan-report-table .kra-cell {
                            font-weight: bold;
                            background-color: #e8f0fb !important;
                            color: #1a3557;
                        }
                        .plan-report-table .subtotal-row td {
                            background-color: #eaf1fb !important;
                            color: #1a3557;
                            font-weight: bold;
                            border-top: 2px solid #2563a8;
                        }
                        .plan-report-table .total-row td {
                            background-color: #1a3557 !important;
                            color: #ffffff !important;
                            font-weight: bold;
                            font-size: 12px;
                        }
                        .plan-report-table .score-cell {
                            text-align: center;
                            vertical-align: middle;
                            font-weight: bold;
                        }
                        .plan-status-badge {
                            display: inline-block;
                            padding: 3px 10px;
                            border-radius: 12px;
                            font-size: 11px;
                            font-weight: bold;
                        }
                    </style>

                    <!-- Compute plan phase status label -->
                    <t t-set="plan_phase_states" t-value="['draft', 'pending_supervisor', 'pending_secondary_supervisor', 'pending_reviewer', 'approved']" />
                    <t t-set="appraisal_phase_states" t-value="['appraisal_draft', 'appraisal_pending_supervisor', 'appraisal_pending_secondary_supervisor', 'appraisal_pending_reviewer', 'appraisal_approved']" />
                    <t t-set="is_in_appraisal_phase" t-value="doc.state in appraisal_phase_states" />
                    <t t-set="display_plan_status" t-value="'Approved' if is_in_appraisal_phase else dict(doc._fields['state'].selection).get(doc.state, doc.state)" />
                    <t t-set="status_bg" t-value="'#198754' if (is_in_appraisal_phase or doc.state == 'approved') else ('#0d6efd' if doc.state in ['pending_supervisor','pending_secondary_supervisor','pending_reviewer'] else '#6c757d')" />

                    <div class="page px-4" t-att-id="'plan-report-' + str(doc.id)">

                        <t t-set="excel_attachment"
                            t-value="doc.env['ir.attachment'].search([('res_model', '=', 'pms.appraisal'), ('res_id', '=', doc.id), ('name', 'like', 'Plan_Summary_%.xlsx')], limit=1, order='id desc')" />

                        <!-- Action Buttons (screen only) -->
                        <div class="d-flex justify-content-end mb-4 screen-only-layout">
                            <a href="#"
                                t-att-onclick="'exportPlanPDF(event, &quot;plan-report-' + str(doc.id) + '&quot;, &quot;Plan_Summary_' + (doc.employee_id.name or 'Report') + '.pdf&quot;)'"
                                style="background-color:#dc3545;color:#ffffff;border:none;padding:10px 18px;border-radius:6px;font-weight:600;text-decoration:none;margin-right:10px;display:inline-flex;align-items:center;cursor:pointer;">
                                <i class="fa fa-file-pdf-o me-2"></i> Export PDF
                            </a>
                            <a t-if="excel_attachment"
                                t-attf-href="/web/content/#{excel_attachment.id}?download=true"
                                style="background-color:#198754;color:#ffffff;border:none;padding:10px 18px;border-radius:6px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;">
                                <i class="fa fa-file-excel-o me-2"></i> Export Excel
                            </a>
                        </div>

                        <!-- Report Header -->
                        <div style="background:#1a3557;color:#fff;padding:14px 20px;text-align:center;margin-bottom:4px;">
                            <div style="font-size:17px;font-weight:bold;">Performance Plan Summary</div>
                            <div style="font-size:13px;color:#aecde8;margin-top:4px;">
                                <t t-esc="doc.employee_id.name" />
                                <t t-if="doc.employee_department_id">
                                    — <t t-esc="doc.employee_department_id.name" />
                                </t>
                            </div>
                        </div>

                        <!-- Info bar -->
                        <div style="background:#2563a8;color:#fff;display:flex;justify-content:space-around;align-items:center;padding:8px 20px;margin-bottom:16px;flex-wrap:wrap;gap:8px;">
                            <div style="text-align:center;">
                                <div style="font-size:9px;color:#aecde8;">Cycle</div>
                                <div style="font-size:11px;font-weight:bold;"><t t-esc="doc.cycle_id.name or '-'" /></div>
                            </div>
                            <div style="text-align:center;">
                                <div style="font-size:9px;color:#aecde8;">Cycle Start</div>
                                <div style="font-size:11px;font-weight:bold;"><t t-esc="str(doc.cycle_id.start_date) if doc.cycle_id.start_date else '-'" /></div>
                            </div>
                            <div style="text-align:center;">
                                <div style="font-size:9px;color:#aecde8;">Cycle End</div>
                                <div style="font-size:11px;font-weight:bold;"><t t-esc="str(doc.cycle_id.end_date) if doc.cycle_id.end_date else '-'" /></div>
                            </div>
                            <div style="text-align:center;">
                                <div style="font-size:9px;color:#aecde8;">Supervisor</div>
                                <div style="font-size:11px;font-weight:bold;"><t t-esc="doc.supervisor_id.name or '-'" /></div>
                            </div>
                            <div t-if="doc.secondary_supervisor_id" style="text-align:center;">
                                <div style="font-size:9px;color:#aecde8;">Secondary</div>
                                <div style="font-size:11px;font-weight:bold;"><t t-esc="doc.secondary_supervisor_id.name" /></div>
                            </div>
                            <div t-if="doc.reviewer_id" style="text-align:center;">
                                <div style="font-size:9px;color:#aecde8;">Reviewer</div>
                                <div style="font-size:11px;font-weight:bold;"><t t-esc="doc.reviewer_id.name" /></div>
                            </div>
                            <div style="text-align:center;">
                                <div style="font-size:9px;color:#aecde8;">Plan Status</div>
                                <div>
                                    <span class="plan-status-badge" t-attf-style="background-color:#{status_bg};color:#fff;">
                                        <t t-esc="display_plan_status" />
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Screen Layout -->
                        <div class="screen-only-layout">
                            <t t-foreach="doc.kra_ids" t-as="kra">
                                <t t-set="active_kpis" t-value="kra.kpi_ids.filtered(lambda k: k.is_selected)" />
                                <t t-if="active_kpis">
                                    <h5 style="margin-top:18px;margin-bottom:6px;color:#1a3557;font-weight:700;border-left:4px solid #2563a8;padding-left:8px;">
                                        <t t-esc="kra.name" />
                                    </h5>
                                    <table class="plan-report-table">
                                        <thead>
                                            <tr>
                                                <th style="width:20%;">KPI Name</th>
                                                <th style="width:20%;">Description</th>
                                                <th style="width:25%;">Criteria</th>
                                                <th style="width:25%;">Target</th>
                                                <th style="width:10%;text-align:center;">Score</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="active_kpis" t-as="kpi">
                                                <tr>
                                                    <td style="font-weight:600;"><t t-esc="kpi.name" /></td>
                                                    <td><t t-esc="kpi.description or ''" /></td>
                                                    <td><t t-esc="kpi.criteria or ''" /></td>
                                                    <td><t t-esc="kpi.target or ''" /></td>
                                                    <td class="score-cell"><t t-esc="kpi.weightage" /></td>
                                                </tr>
                                            </t>
                                            <tr class="subtotal-row">
                                                <td colspan="4" style="text-align:right;">KRA Total</td>
                                                <td class="score-cell">
                                                    <t t-esc="'%.2f' % sum(active_kpis.mapped('weightage'))" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                            </t>

                            <!-- Grand Total -->
                            <table class="plan-report-table" style="margin-top:8px;">
                                <tbody>
                                    <tr class="total-row">
                                        <td style="text-align:right;width:90%;">Total Score</td>
                                        <td style="text-align:center;width:10%;">
                                            <t t-esc="'%.2f' % doc.planning_total_score" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Print Layout -->
                        <div class="print-only-layout">
                            <table class="plan-report-table">
                                <thead>
                                    <tr>
                                        <th style="width:14%;">KRA Name</th>
                                        <th style="width:15%;">KPI Name</th>
                                        <th style="width:19%;">Description</th>
                                        <th style="width:24%;">Criteria</th>
                                        <th style="width:18%;">Target</th>
                                        <th style="width:10%;text-align:center;">Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.kra_ids" t-as="kra">
                                        <t t-set="active_kpis" t-value="kra.kpi_ids.filtered(lambda k: k.is_selected)" />
                                        <t t-foreach="active_kpis" t-as="kpi">
                                            <tr>
                                                <td class="kra-cell"><t t-esc="kra.name" /></td>
                                                <td style="font-weight:600;"><t t-esc="kpi.name" /></td>
                                                <td><t t-esc="kpi.description or ''" /></td>
                                                <td><t t-esc="kpi.criteria or ''" /></td>
                                                <td><t t-esc="kpi.target or ''" /></td>
                                                <td class="score-cell"><t t-esc="kpi.weightage" /></td>
                                            </tr>
                                        </t>
                                    </t>
                                    <tr class="total-row">
                                        <td colspan="5" style="text-align:right;">Total Score</td>
                                        <td style="text-align:center;">
                                            <t t-esc="'%.2f' % doc.planning_total_score" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>

                    <script type="text/javascript"
                        src="/hr_employee_evaluation/static/lib/html2pdf.bundle.min.js">
                    </script>

                    <script type="text/javascript">
                        function exportPlanPDF(e, containerId, filename) {
                            e.preventDefault();
                            var container = document.getElementById(containerId);
                            if (!container) { alert('Report content not found.'); return; }

                            var screenLayouts = container.querySelectorAll('.screen-only-layout');
                            var printLayouts  = container.querySelectorAll('.print-only-layout');

                            screenLayouts.forEach(function(el) { el.style.setProperty('display', 'none', 'important'); });
                            printLayouts.forEach(function(el)  { el.style.setProperty('display', 'block', 'important'); });

                            var opt = {
                                margin:      [10, 8, 10, 8],
                                filename:    filename || 'Plan_Summary.pdf',
                                image:       { type: 'jpeg', quality: 0.98 },
                                html2canvas: { scale: 2, useCORS: true, logging: false, scrollY: 0 },
                                jsPDF:       { unit: 'mm', format: 'a4', orientation: 'landscape' },
                                pagebreak:   { mode: ['avoid-all', 'css', 'legacy'] }
                            };

                            html2pdf()
                                .set(opt)
                                .from(container)
                                .save()
                                .then(function() {
                                    screenLayouts.forEach(function(el) { el.style.removeProperty('display'); });
                                    printLayouts.forEach(function(el)  { el.style.removeProperty('display'); });
                                });
                        }
                    </script>

                </t>
            </t>
        </t>
    </template>

</odoo>