<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pms_scoring_engine_list" model="ir.ui.view">
        <field name="name">pms.scoring.engine.list</field>
        <field name="model">pms.scoring.engine</field>
        <field name="arch" type="xml">
            <list string="Scoring Engines"
                  decoration-success="is_default == True">
                <field name="name"/>
                <field name="line_count" string="Ranges"/>
                <field name="score_min" string="Min Score" widget="float" optional="show"/>
                <field name="score_max" string="Max Score" widget="float" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_pms_scoring_engine_form" model="ir.ui.view">
        <field name="name">pms.scoring.engine.form</field>
        <field name="model">pms.scoring.engine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Engine Name"/>
                        <h1>
                            <field name="name"
                                   style="width: 100%;"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="is_default"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Score Ranges" name="page_ranges">

                            <field name="line_ids"
                                   nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="rating"
                                           placeholder="e.g. Excellent"
                                           style="width: 100%;"/>
                                    <field name="min_score"
                                           string="Min Score"
                                           widget="float"/>
                                    <field name="max_score"
                                           string="Max Score"
                                           widget="float"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pms_scoring_engine" model="ir.actions.act_window">
        <field name="name">Scoring Engines</field>
        <field name="res_model">pms.scoring.engine</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_pms_scoring_engine_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_pms_scoring_engine_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No scoring engines defined yet
            </p>
            <p>
                Create a scoring engine to define score ranges and their rating labels
            </p>
        </field>
    </record>



</odoo>