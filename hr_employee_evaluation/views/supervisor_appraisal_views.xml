<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_appraisals_all_list" model="ir.ui.view">
        <field name="name">pms.appraisal.supervisor.appraisal.list</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <list string="Employee Appraisals" create="false" delete="false">
                <field name="employee_id" string="Employee Name" />
                <field name="employee_evaluation_group_id" string="Evaluation Group" />
                <field name="supervisor_id" string="Manager" />
                <field name="secondary_supervisor_id" string="Secondary Manager" />
                <field name="reviewer_id" string="Reviewer" />
                <field name="state"
                    widget="badge"
                    decoration-info="state == 'appraisal_draft'"
                    decoration-warning="state in ('appraisal_pending_supervisor', 'appraisal_pending_secondary_supervisor', 'appraisal_pending_reviewer')"
                    decoration-success="state == 'appraisal_approved'" />
            </list>
        </field>
    </record>

    <record id="view_employee_appraisals_supervisor_form" model="ir.ui.view">
        <field name="name">pms.appraisal.supervisor.appraisal.form</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <form string="Employee Appraisal" create="false" delete="false">
                <header>
                    <!-- Info: waiting for employee self-rating -->
                    <div class="alert alert-info" role="alert"
                        invisible="state != 'appraisal_draft' or is_hr_manager">
                        <strong>Waiting:</strong> Employee has not submitted their self-rating yet.
                    </div>

                    <!-- HR: Submit self rating on behalf of employee -->
                    <button name="action_submit_self_rating"
                        string="Submit(HR)"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'appraisal_draft' or not is_hr_manager"
                        groups="hr_employee_evaluation.group_pms_hr_manager"
                        confirm="You are submitting the self-rating on behalf of the employee. Continue?" />

                    <!-- Supervisor submit (supervisor or HR) -->
                    <button name="action_supervisor_submit_rating"
                        string="Submit"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'appraisal_pending_supervisor' or (not is_supervisor_of_appraisal and not is_hr_manager)"
                        groups="hr_employee_evaluation.group_pms_hr_manager,hr_employee_evaluation.group_pms_supervisor"
                        confirm="Are you sure you want to submit your rating? One or more KPIs may have a score of 0. You will not be able to edit it after submission." />

                    <!-- Secondary supervisor submit (supervisor or HR) -->
                    <button name="action_secondary_supervisor_submit_rating"
                        string="Submit"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'appraisal_pending_secondary_supervisor' or (not is_secondary_supervisor_of_appraisal and not is_hr_manager)"
                        groups="hr_employee_evaluation.group_pms_hr_manager,hr_employee_evaluation.group_pms_supervisor"
                        confirm="Are you sure you want to submit your rating? One or more KPIs may have a score of 0. You will not be able to edit it after submission." />

                    <!-- Reviewer submit (reviewer or HR) -->
                    <button name="action_reviewer_submit_rating"
                        string="Submit"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'appraisal_pending_reviewer' or (not is_reviewer_of_appraisal and not is_hr_manager)"
                        groups="hr_employee_evaluation.group_pms_hr_manager,hr_employee_evaluation.group_pms_reviewer"
                        confirm="Are you sure you want to submit the final rating? One or more KPIs may have a score of 0. You will not be able to edit it after submission." />

                    <!-- HR: Reset to draft -->
                    <button name="action_hr_reset_appraisal_to_draft"
                        string="Reset to Draft"
                        type="object"
                        class="btn-secondary"
                        groups="hr_employee_evaluation.group_pms_hr_manager"
                        invisible="state not in ('appraisal_pending_supervisor', 'appraisal_pending_secondary_supervisor', 'appraisal_pending_reviewer', 'appraisal_approved')"
                        confirm="This will clear all appraisal scores and reset to draft. Continue?" />
                </header>

                <sheet style="max-width: 100% !important; width: 100% !important;">
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                            type="object"
                            name="action_view_appraisal_summary"
                            icon="fa-list-alt"
                            target="_blank">
                            <div class="o_stat_info">
                                <span class="o_stat_text">View Summary</span>
                            </div>
                        </button>

                        <button type="button"
                            class="oe_stat_button pms-chatter-toggle-btn"
                            icon="fa-comments"
                            title="Toggle Chatter">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Chatter</span>
                            </div>
                        </button>

                        <button name="action_sync_competency_scores"
                            string="Sync Competency"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-refresh"
                            groups="hr_employee_evaluation.group_pms_hr_manager"
                            invisible="not template_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sync Competency</span>
                            </div>
                        </button>
                    </div>

                    <!-- Zero score warnings -->
                    <div class="alert alert-warning"
                        invisible="state != 'appraisal_pending_supervisor' or not is_supervisor_of_appraisal or not supervisor_has_zero_scores">
                        <i class="fa fa-exclamation-triangle me-1" />
                        <strong>Warning:</strong> One or more KPIs have a score of 0.
                    </div>

                    <div class="alert alert-warning"
                        invisible="state != 'appraisal_pending_secondary_supervisor' or not is_secondary_supervisor_of_appraisal or not secondary_supervisor_has_zero_scores">
                        <i class="fa fa-exclamation-triangle me-1" />
                        <strong>Warning:</strong> One or more KPIs have a score of 0.
                    </div>

                    <div class="alert alert-warning"
                        invisible="state != 'appraisal_pending_reviewer' or not is_reviewer_of_appraisal or not reviewer_has_zero_scores">
                        <i class="fa fa-exclamation-triangle me-1" />
                        <strong>Warning:</strong> One or more KPIs have a score of 0.
                    </div>

                    <!-- ═══ Two-column layout ═══ -->
                    <div class="pms_appraisal_layout"
                        style="display:grid; grid-template-columns:auto 360px; gap:24px; align-items:start; margin-bottom:1.5rem;">
                        <!-- LEFT: Profile + stat cards -->
                        <div>
                            <div class="pms_plan_header">
                                <div class="pms_plan_profile_row">
                                    <field name="employee_id"
                                        widget="many2one_avatar_employee"
                                        readonly="1"
                                        options="{'no_open': True}"
                                        nolabel="1"
                                        class="pms_plan_avatar_field" />
                                    <div class="pms_plan_profile_info">
                                        <div class="pms_plan_emp_name">
                                            <field name="employee_id" readonly="1"
                                                options="{'no_open': True}" nolabel="1"
                                                class="pms_emp_name_field" />
                                        </div>
                                        <div class="pms_plan_meta_row">
                                            <span class="pms_plan_meta_item">
                                                <i class="fa fa-briefcase me-1 text-muted" />
                                                <field name="employee_job_id" string="Job Position"
                                                    readonly="1" options="{'no_open': True}"
                                                    nolabel="1" class="d-inline" />
                                            </span>
                                            <span class="pms_plan_meta_sep">·</span>
                                            <span class="pms_plan_meta_item">
                                                <i class="fa fa-building me-1 text-muted" />
                                                <field name="employee_department_id"
                                                    string="Department" readonly="1"
                                                    options="{'no_open': True}" nolabel="1"
                                                    class="d-inline" />
                                            </span>
                                            <span class="pms_plan_meta_sep">·</span>
                                            <span class="pms_plan_meta_item">
                                                <i class="fa fa-users me-1 text-muted" />
                                                <field name="employee_evaluation_group_id"
                                                    string="Evaluation Group" readonly="1"
                                                    options="{'no_open': True}" nolabel="1"
                                                    class="d-inline" />
                                            </span>
                                        </div>
                                        <div class="pms_plan_status_row mt-2">
                                            <field name="state" widget="statusbar"
                                                statusbar_visible="appraisal_draft,appraisal_pending_supervisor,appraisal_pending_secondary_supervisor,appraisal_pending_reviewer,appraisal_approved"
                                                class="pms_inline_statusbar" />
                                        </div>
                                    </div>
                                </div>
                                <div class="pms_plan_stats_row mt-3">
                                    <div class="pms_plan_stat_card pms_stat_score_alloc">
                                        <div class="pms_stat_label">Total Score</div>
                                        <div class="pms_stat_value">
                                            <field name="allocated_total_score" widget="float"
                                                nolabel="1" readonly="1" />
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_score_current"
                                        invisible="not ((state == 'appraisal_pending_supervisor' and can_supervisor_rate) or (state == 'appraisal_pending_secondary_supervisor' and can_secondary_supervisor_rate) or (state == 'appraisal_pending_reviewer' and can_reviewer_rate))">
                                        <div class="pms_stat_label">Current Total</div>
                                        <div class="pms_stat_value">
                                            <field name="current_total_score" widget="float"
                                                nolabel="1" readonly="1" />
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_score_current"
                                        invisible="state != 'appraisal_approved'">
                                        <div class="pms_stat_label">Final Score</div>
                                        <div class="pms_stat_value" style="color:#6c5ecf;">
                                            <field name="final_appraisal_score" widget="float"
                                                nolabel="1" readonly="1" />
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_date_start">
                                        <div class="pms_stat_label">Appraisal Start</div>
                                        <div class="pms_stat_value">
                                            <field name="appraisal_start_date_display" nolabel="1"
                                                readonly="1" />
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_date_end">
                                        <div class="pms_stat_label">Appraisal End</div>
                                        <div class="pms_stat_value">
                                            <field name="appraisal_end_date_display" nolabel="1"
                                                readonly="1" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Plan details card -->
                        <div>
                            <div class="pms_details_card">
                                <div class="pms_details_section_title">Appraisal Details</div>
                                <div class="pms_detail_row">
                                    <span class="pms_detail_label">Manager</span>
                                    <div class="pms_detail_value">
                                        <field name="supervisor_id" readonly="1"
                                            options="{'no_open': True}" nolabel="1" />
                                    </div>
                                </div>
                                <div class="pms_detail_row" invisible="not secondary_supervisor_id">
                                    <span class="pms_detail_label">Secondary Manager</span>
                                    <div class="pms_detail_value">
                                        <field name="secondary_supervisor_id" readonly="1"
                                            options="{'no_open': True}" nolabel="1" />
                                    </div>
                                </div>
                                <div class="pms_detail_row" invisible="not reviewer_id">
                                    <span class="pms_detail_label">Reviewer</span>
                                    <div class="pms_detail_value">
                                        <field name="reviewer_id" readonly="1"
                                            options="{'no_open': True}" nolabel="1" />
                                    </div>
                                </div>
                                <div class="pms_detail_row">
                                    <span class="pms_detail_label">Template</span>
                                    <div class="pms_detail_value">
                                        <field name="template_id" readonly="1"
                                            options="{'no_open': True}" nolabel="1" />
                                    </div>
                                </div>
                                <div class="pms_detail_row" invisible="not appraisal_reset_date">
                                    <span class="pms_detail_label">Last Reset By HR</span>
                                    <div class="pms_detail_value">
                                        <field name="appraisal_reset_date" readonly="1" nolabel="1" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Access control flags (invisible) ──────────── -->
                    <field name="is_hr_manager" invisible="1" />
                    <field name="is_supervisor_of_appraisal" invisible="1" />
                    <field name="is_secondary_supervisor_of_appraisal" invisible="1" />
                    <field name="is_reviewer_of_appraisal" invisible="1" />
                    <field name="can_employee_self_rate" invisible="1" />
                    <field name="can_supervisor_rate" invisible="1" />
                    <field name="can_secondary_supervisor_rate" invisible="1" />
                    <field name="can_reviewer_rate" invisible="1" />
                    <field name="supervisor_has_zero_scores" invisible="1" />
                    <field name="secondary_supervisor_has_zero_scores" invisible="1" />
                    <field name="reviewer_has_zero_scores" invisible="1" />
                    <field name="cycle_id" invisible="1" />

                    <!-- ── Competency score rows -->
                    <field name="competency_score_ids" invisible="1">
                        <list>
                            <field name="competency_line_id" />
                            <field name="group_id" />
                            <field name="group_name" />
                            <field name="group_hr_code" />
                            <field name="group_sequence" />
                            <field name="line_name" />
                            <field name="line_description" />
                            <field name="line_full_code" />
                            <field name="line_points" />
                            <field name="line_sequence" />
                            <field name="self_score" />
                            <field name="self_remarks" />
                            <field name="supervisor_score" />
                            <field name="supervisor_remarks" />
                            <field name="secondary_supervisor_score" />
                            <field name="secondary_supervisor_remarks" />
                            <field name="reviewer_score" />
                            <field name="reviewer_remarks" />
                        </list>
                    </field>

                    <!-- ── KRA Tabs Widget ──────────────────────────── -->
                    <field name="kra_ids"
                        widget="kra_tabs_widget"
                        options="{'mode': 'appraisal_supervisor'}"
                        readonly="not (can_supervisor_rate or can_secondary_supervisor_rate or can_reviewer_rate or can_employee_self_rate or is_hr_manager) or state == 'appraisal_approved'"
                        nolabel="1">
                        <list>
                            <field name="name" />
                            <field name="evidence_attachment_ids" />
                            <field name="kpi_ids">
                                <list>
                                    <field name="name" />
                                    <field name="description" />
                                    <field name="criteria" />
                                    <field name="weightage" />
                                    <field name="target" />
                                    <field name="is_selected" />
                                    <field name="self_score" />
                                    <field name="self_remarks" />
                                    <field name="supervisor_score" />
                                    <field name="supervisor_remarks" />
                                    <field name="secondary_supervisor_score" />
                                    <field name="secondary_supervisor_score_remarks" />
                                    <field name="reviewer_score" />
                                    <field name="reviewer_remarks" />
                                </list>
                            </field>
                        </list>
                    </field>

                </sheet>

                <chatter />
            </form>
        </field>
    </record>

</odoo>