<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list view for subordinate plans -->
    <record id="view_employee_plans_all_list" model="ir.ui.view">
        <field name="name">pms.appraisal.supervisor.list</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <list string="Employee Plans"
                create="false"
                delete="false"
                decoration-muted="state == 'draft'">
                <field name="employee_id" string="Employee Name" />
                <field name="employee_evaluation_group_id" string="Evaluation Group" />
                <field name="supervisor_id" string="Manager" />
                <field name="secondary_supervisor_id" string="Secondary Manager" />
                <field name="reviewer_id" string="Reviewer" />
                <field name="planning_start_date" string="Planning Start" />
                <field name="planning_end_date" string="Planning Deadline" />
                <field name="state"
                    widget="badge"
                    decoration-muted="state == 'draft'"
                    decoration-warning="state in ('pending_supervisor', 'pending_secondary_supervisor', 'pending_reviewer')"
                    decoration-success="state == 'approved'" />
            </list>
        </field>
    </record>

    <record id="view_employee_plans_supervisor_form" model="ir.ui.view">
        <field name="name">pms.appraisal.supervisor.form</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <form string="Employee Performance Plan" create="false" delete="false">
                <header>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        <strong>Not Yet Submitted:</strong> This employee has not submitted their
                        plan yet. </div>

                    <!--
                        Approve visible only to the assigned supervisor 
                    -->
                    <button name="action_supervisor_approve"
                        string="Approve Plan"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'pending_supervisor' or not is_supervisor_of_appraisal"
                        groups="hr_employee_evaluation.group_pms_supervisor"
                        confirm="Are you sure you want to approve this performance plan?" />

                    <button name="action_secondary_supervisor_approve"
                        string="Approve Plan"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'pending_secondary_supervisor' or not is_secondary_supervisor_of_appraisal"
                        groups="hr_employee_evaluation.group_pms_supervisor"
                        confirm="Are you sure you want to approve this performance plan?" />

                    <button name="action_reviewer_approve"
                        string="Approve Plan"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'pending_reviewer' or not is_reviewer_of_appraisal"
                        groups="hr_employee_evaluation.group_pms_reviewer"
                        confirm="Are you sure you want to give final approval to this performance plan?" />

                    <button name="action_hr_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        class="btn-secondary"
                        groups="hr_employee_evaluation.group_pms_hr_manager"
                        invisible="state == 'draft' or cycle_state not in ('planning', 'monitoring')"
                        confirm="Are you sure you want to reset this plan to draft?" />

                    <!-- state statusbar moved inline to profile header -->
                </header>

                <sheet style="max-width: 100% !important; width: 100% !important;">
                    <div class="oe_button_box" name="button_box">      <!-- button to view plan summary,
                        visible to supervisors and reviewers -->
                        <button class="oe_stat_button"
                            type="object"
                            name="action_view_plan_summary"
                            icon="fa-list-alt"
                            target="_blank">
                            <div class="o_stat_info">
                                <span class="o_stat_text">View Summary</span>
                            </div>
                        </button>

                        <button type="button"
                            class="oe_stat_button pms-chatter-toggle-btn"
                            icon="fa-comments"
                            title="Toggle Chatter">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Chatter</span>
                            </div>
                        </button>
                    </div>


                    <!-- Hidden fields needed for logic only -->
                    <field name="employee_id" readonly="1" options="{'no_open': True}" invisible="1" />
                    <field name="employee_job_id" string="Job Position" readonly="1"
                        options="{'no_open': True}" invisible="1" />
                    <field name="employee_department_id" string="Department" readonly="1"
                        options="{'no_open': True}" invisible="1" />
                    <field name="employee_evaluation_group_id" string="Evaluation Group"
                        readonly="1" options="{'no_open': True}" invisible="1" />
                    <field name="planning_start_date" string="Start Date" readonly="1" invisible="1" />
                    <field name="planning_end_date" string="Deadline" readonly="1" invisible="1" />
                    <field name="template_total_score" string="Template Total" readonly="1"
                        widget="float" invisible="1" />
                    <field name="planning_total_score" string="Employee's Total" readonly="1"
                        widget="float"
                        decoration-success="planning_total_score == template_total_score"
                        decoration-danger="planning_total_score != template_total_score"
                        invisible="1" />

                    <!-- Two-column layout: profile+stats left, details card right -->
                    <div class="pms_plan_two_col_wrapper">

                        <!-- LEFT: Profile + stat cards -->
                        <div class="pms_plan_left_col">
                            <div class="pms_plan_header">
                                <div class="pms_plan_profile_row">
                                    <field name="employee_id"
                                        widget="many2one_avatar_employee"
                                        readonly="1"
                                        options="{'no_open': True}"
                                        nolabel="1"
                                        class="pms_plan_avatar_field" />
                                    <div class="pms_plan_profile_info">
                                        <div class="pms_plan_emp_name">
                                            <field name="employee_id" readonly="1"
                                                options="{'no_open': True}" nolabel="1"
                                                class="pms_emp_name_field" />
                                        </div>
                                        <div class="pms_plan_meta_row">
                                            <span class="pms_plan_meta_item">
                                                <i class="fa fa-briefcase me-1 text-muted" />
                                                <field name="employee_job_id" string="Job Position"
                                                    readonly="1" options="{'no_open': True}"
                                                    nolabel="1" class="d-inline" />
                                            </span>
                                            <span class="pms_plan_meta_sep">·</span>
                                            <span class="pms_plan_meta_item">
                                                <i class="fa fa-building me-1 text-muted" />
                                                <field name="employee_department_id"
                                                    string="Department" readonly="1"
                                                    options="{'no_open': True}" nolabel="1"
                                                    class="d-inline" />
                                            </span>
                                            <span class="pms_plan_meta_sep">·</span>
                                            <span class="pms_plan_meta_item">
                                                <i class="fa fa-users me-1 text-muted" />
                                                <field name="employee_evaluation_group_id"
                                                    string="Evaluation Group" readonly="1"
                                                    options="{'no_open': True}" nolabel="1"
                                                    class="d-inline" />
                                            </span>
                                        </div>
                                        <div class="pms_plan_status_row mt-2">
                                            <field name="state" widget="statusbar"
                                                statusbar_visible="draft,pending_supervisor,pending_secondary_supervisor,pending_reviewer,approved"
                                                class="pms_inline_statusbar" />
                                        </div>
                                    </div>
                                </div>
                                <div class="pms_plan_stats_row mt-3">
                                    <div class="pms_plan_stat_card pms_stat_score_alloc">
                                        <div class="pms_stat_label">Allocated Score</div>
                                        <div class="pms_stat_value">
                                            <field name="template_total_score" widget="float"
                                                nolabel="1" readonly="1" />
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_score_current">
                                        <div class="pms_stat_label">Employee Total</div>
                                        <div class="pms_stat_value">
                                            <field name="planning_total_score" widget="float"
                                                nolabel="1" readonly="1"
                                                decoration-success="planning_total_score == template_total_score"
                                                decoration-danger="planning_total_score != template_total_score" />
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_date_start">
                                        <div class="pms_stat_label">Planning Start</div>
                                        <div class="pms_stat_value">
                                            <field name="planning_start_date" nolabel="1"
                                                readonly="1" />
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_date_end">
                                        <div class="pms_stat_label">Deadline</div>
                                        <div class="pms_stat_value">
                                            <field name="planning_end_date" nolabel="1" readonly="1" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Plan details card -->
                        <div class="pms_plan_right_col">
                            <div class="pms_details_card">

                                <div class="pms_details_section_title">Plan Details</div>
                                <div class="pms_detail_row">
                                    <span class="pms_detail_label">Manager</span>
                                    <div class="pms_detail_value">
                                        <field name="supervisor_id" readonly="1"
                                            options="{'no_open': True}" nolabel="1" />
                                    </div>
                                </div>
                                <div class="pms_detail_row" invisible="not secondary_supervisor_id">
                                    <span class="pms_detail_label">Secondary Manager</span>
                                    <div class="pms_detail_value">
                                        <field name="secondary_supervisor_id" readonly="1"
                                            options="{'no_open': True}" nolabel="1" />
                                    </div>
                                </div>
                                <div class="pms_detail_row" invisible="not reviewer_id">
                                    <span class="pms_detail_label">Reviewer</span>
                                    <div class="pms_detail_value">
                                        <field name="reviewer_id" readonly="1"
                                            options="{'no_open': True}" nolabel="1" />
                                    </div>
                                </div>
                                <div class="pms_detail_row">
                                    <span class="pms_detail_label">Template</span>
                                    <div class="pms_detail_value">
                                        <field name="template_id" readonly="1"
                                            options="{'no_open': True}" nolabel="1" />
                                    </div>
                                </div>

                                <div class="pms_detail_row" invisible="not submitted_date">
                                    <span class="pms_detail_label">Submitted On</span>
                                    <div class="pms_detail_value">
                                        <field name="submitted_date" readonly="1" nolabel="1" />
                                    </div>
                                </div>
                                <div class="pms_detail_row" invisible="not draft_reset_date">
                                    <span class="pms_detail_label">Last Reset By HR</span>
                                    <div class="pms_detail_value">
                                        <field name="draft_reset_date" readonly="1" nolabel="1" />
                                    </div>
                                </div>
                                <div class="pms_detail_row" invisible="not resubmission_deadline">
                                    <span class="pms_detail_label">Resubmit By</span>
                                    <div class="pms_detail_value">
                                        <field name="resubmission_deadline" readonly="1" nolabel="1" />
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                    <!-- Access control flags -->
                    <field name="is_supervisor_of_appraisal" invisible="1" />
                    <field name="is_secondary_supervisor_of_appraisal" invisible="1" />
                    <field name="is_reviewer_of_appraisal" invisible="1" />
                    <field name="can_supervisor_edit_target" invisible="1" />
                    <field name="can_secondary_supervisor_edit_target" invisible="1" />
                    <field name="cycle_id" invisible="1" />


                    <field name="kra_ids"
                        widget="kra_tabs_widget"
                        options="{'mode': 'supervisor'}"
                        readonly="not (can_supervisor_edit_target or can_secondary_supervisor_edit_target)"
                        nolabel="1">
                        <list>
                            <field name="name" />
                            <field name="kpi_ids">
                                <list>
                                    <field name="name" />
                                    <field name="description" />
                                    <field name="criteria" />
                                    <field name="weightage" />
                                    <field name="is_selected" />
                                    <field name="target" />
                                    <field name="planning_remarks" />

                                    <field name="snapshot_employee_target" invisible="1" />
                                    <field name="snapshot_employee_criteria" invisible="1" />

                                    <field name="snapshot_supervisor_target" invisible="1" />
                                    <field name="snapshot_supervisor_criteria" invisible="1" />

                                    <field name="snapshot_secondary_target" invisible="1" />
                                    <field name="snapshot_secondary_criteria" invisible="1" />
                                </list>
                            </field>
                        </list>
                    </field>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

</odoo>