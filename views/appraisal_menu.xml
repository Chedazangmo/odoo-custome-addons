                name="Employee Evaluation"
                sequence="80"
                web_icon="hr_employee_evaluation,static/description/icon.png"/>

        <!-- Planning menus -->
        <menuitem
                id="menu_performance_planning"
                name="Planning"
                parent="menu_appraisal_root"
