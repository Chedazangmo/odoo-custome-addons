<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- ══════════════════════════════════════════════════════
         ROOT MENU
    ══════════════════════════════════════════════════════ -->
        <menuitem id="menu_appraisal_root"
                name="Employee Evaluation"
                sequence="85" />

        <!-- ══════════════════════════════════════════════════════
         MAIN MENUS
    ══════════════════════════════════════════════════════ -->
        <menuitem id="menu_performance_planning"
                name="My Plan"
                parent="menu_appraisal_root"
                action="action_employee_performance_planning"
                groups="hr_employee_evaluation.group_pms_employee"
                sequence="5" />

        <menuitem id="menu_employee_plans"
                name="Employee Plans"
                parent="menu_appraisal_root"
                action="action_employee_plans_all"
                groups="hr_employee_evaluation.group_pms_supervisor"
                sequence="10" />

        <!-- ══════════════════════════════════════════════════════
         CONFIGURATION MENU
    ══════════════════════════════════════════════════════ -->
        <menuitem id="menu_appraisal_configuration"
                name="Configuration"
                parent="menu_appraisal_root"
                groups="hr_employee_evaluation.group_pms_hr_manager"
                sequence="100" />

        <menuitem id="menu_appraisal_templates"
                name="Templates"
                parent="menu_appraisal_configuration"
                action="action_appraisal_template"
                groups="hr_employee_evaluation.group_pms_hr_manager"
                sequence="1" />

        <menuitem id="menu_activate_cycle"
                name="Activate Cycle"
                parent="menu_appraisal_configuration"
                action="action_pms_cycle"
                groups="hr_employee_evaluation.group_pms_hr_manager"
                sequence="2" />

        <!-- ══════════════════════════════════════════════════════
         COMPETENCY TEMPLATE
    ══════════════════════════════════════════════════════ -->

        <!-- Deactivate the old floating competency menu -->
        <record id="competency_exact.menu_competency_template" model="ir.ui.menu">
                <field name="active" eval="False" />
        </record>

        <!-- Re-create it under Configuration -->
        <menuitem id="menu_competency_template_config"
                name="Competency Template"
                parent="menu_appraisal_configuration"
                action="competency_exact.action_competency_template"
                groups="hr_employee_evaluation.group_pms_hr_manager"
                sequence="3" />

</odoo>