<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_appraisal_list" model="ir.ui.view">
        <field name="name">pms.appraisal.employee.appraisal.list</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <list string="My Appraisal" create="false" delete="false">
                <field name="employee_id" string="Employee Name"/>
                <field name="employee_evaluation_group_id" string="Evaluation Group"/>
                <field name="supervisor_id" string="Manager"/>
                <field name="secondary_supervisor_id" string="Secondary Manager"/>
                <field name="reviewer_id" string="Reviewer"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'appraisal_draft'"
                       decoration-warning="state in ('appraisal_pending_supervisor', 'appraisal_pending_secondary_supervisor', 'appraisal_pending_reviewer')"
                       decoration-success="state == 'appraisal_approved'"/>
            </list>
        </field>
    </record>

    <record id="view_employee_appraisal_form" model="ir.ui.view">
        <field name="name">pms.appraisal.employee.appraisal.form</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <form string="My Appraisal" create="false" delete="false">
                <header>
                    <button name="action_submit_self_rating"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'appraisal_draft' or not is_own_appraisal"
                            confirm="Are you sure you want to submit your self-rating?"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="appraisal_draft,appraisal_pending_supervisor,appraisal_pending_secondary_supervisor,appraisal_pending_reviewer,appraisal_approved"/>
                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_view_appraisal_summary"
                                icon="fa-list-alt"
                                target="_blank">
                            <div class="o_stat_info">
                                <span class="o_stat_text">View Summary</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="alert alert-warning"
                         invisible="state != 'appraisal_draft' or not is_own_appraisal or not self_has_zero_scores">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        <strong>Warning:</strong> Some KPIs have a score of 0. 
                    </div>

                    <group>
                        <group string="Employee Information">
                            <field name="employee_id" readonly="1"/>
                            <field name="employee_job_id" string="Job Position" readonly="1"/>
                            <field name="employee_department_id" string="Department" readonly="1"/>
                            <field name="employee_evaluation_group_id" string="Evaluation Group" readonly="1"/>
                        </group>

                        <group string="Plan Details">
                            <field name="supervisor_id" string="Manager" readonly="1"/>
                            <field name="secondary_supervisor_id" string="Secondary Manager" readonly="1"/>
                            <field name="reviewer_id" string="Reviewer" readonly="1"/>
                            <field name="template_id" string="Template Name" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Appraisal Period">
                            <field name="appraisal_start_date_display" string="Appraisal Start" readonly="1"/>
                            <field name="appraisal_end_date_display" string="Appraisal End" readonly="1"/>
                            <field name="appraisal_reset_date" string="Last Reset By HR" readonly="1"
                                   invisible="not appraisal_reset_date"/>
                        </group>

                        <group string="Score Summary">
                            <field name="template_total_score"
                                   string="Total Allocated Score"
                                   widget="float"
                                   readonly="1"
                                   class="fw-bold text-primary"/>
                            <field name="current_total_score"
                                   string="Current Total"
                                   widget="float"
                                   readonly="1"
                                   class="fw-bold"/>
                            <field name="final_appraisal_score"
                                   string="Final Appraisal Score"
                                   widget="float"
                                   readonly="1"
                                   class="fw-bold text-primary"
                                   invisible="state != 'appraisal_approved'"/>
                        </group>
                    </group>

                    <!-- Access control flags -->
                    <field name="is_own_appraisal"              invisible="1"/>
                    <field name="can_employee_self_rate"         invisible="1"/>
                    <field name="self_has_zero_scores"           invisible="1"/>
                    <field name="supervisor_has_zero_scores"     invisible="1"/>
                    <field name="secondary_supervisor_has_zero_scores" invisible="1"/>
                    <field name="reviewer_has_zero_scores"       invisible="1"/>
                    <field name="can_secondary_supervisor_rate"  invisible="1"/>
                    <field name="can_reviewer_rate"              invisible="1"/>
                    <field name="cycle_id"                       invisible="1"/>

                            <field name="kra_ids"
                                   widget="kra_tabs_widget"
                                   options="{'mode': 'appraisal_employee'}"
                                   readonly="not can_employee_self_rate"
                                   nolabel="1"
                                   class="w-100 d-block"
                                   >
                                <list>
                                    <field name="name"/>
                                    <field name="kpi_ids">
                                        <list>
                                            <field name="name"/>
                                            <field name="description"/>
                                            <field name="criteria"/>
                                            <field name="weightage"/>
                                            <field name="target"/>
                                            <field name="is_selected"/>
                                            <field name="self_score"/>
                                            <field name="self_remarks"/>
                                            <field name="supervisor_score"/>
                                            <field name="supervisor_remarks"/>
                                            <field name="secondary_supervisor_score"/>
                                            <field name="secondary_supervisor_score_remarks"/>
                                            <field name="reviewer_score"/>
                                            <field name="reviewer_remarks"/>
                                        </list>
                                    </field>
                                </list>
                            </field>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_employee_appraisal" model="ir.actions.act_window">
        <field name="name">My Appraisal</field>
        <field name="res_model">pms.appraisal</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_employee_appraisal_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_employee_appraisal_form')})]"/>
        
        <field name="domain">[
            ('employee_id.user_id', '=', uid),
            ('cycle_id.state', 'in', ['appraisal', 'completed']),
            ('state', 'in', ['appraisal_draft', 'appraisal_pending_supervisor',
                             'appraisal_pending_secondary_supervisor',
                             'appraisal_pending_reviewer', 'appraisal_approved'])
        ]</field>
        <field name="context">{
            'create': False,
            'delete': False,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No active appraisal currently.</p>
        </field>
    </record>

</odoo>