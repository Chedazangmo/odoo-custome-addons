<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_appraisal_list" model="ir.ui.view">
        <field name="name">pms.appraisal.employee.appraisal.list</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <list string="My Appraisal" create="false" delete="false">
                <field name="employee_id" string="Employee Name" />
                <field name="employee_evaluation_group_id" string="Evaluation Group" />
                <field name="supervisor_id" string="Manager" />
                <field name="secondary_supervisor_id" string="Secondary Manager" />
                <field name="reviewer_id" string="Reviewer" />
                <field name="state"
                    widget="badge"
                    decoration-info="state == 'appraisal_draft'"
                    decoration-warning="state in ('appraisal_pending_supervisor', 'appraisal_pending_secondary_supervisor', 'appraisal_pending_reviewer')"
                    decoration-success="state == 'appraisal_approved'" />
            </list>
        </field>
    </record>

    <record id="view_employee_appraisal_form" model="ir.ui.view">
        <field name="name">pms.appraisal.employee.appraisal.form</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <form string="My Appraisal" create="false" delete="false">
                <header>
                    <button name="action_submit_self_rating"
                        string="Submit"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'appraisal_draft' or not is_own_appraisal"
                        confirm="Are you sure you want to submit your self-rating?" />
                </header>

                <sheet style="max-width: 100% !important; width: 100% !important;">

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                            type="object"
                            name="action_view_appraisal_summary"
                            icon="fa-list-alt"
                            target="_blank">
                            <div class="o_stat_info">
                                <span class="o_stat_text">View Summary</span>
                            </div>
                        </button>

                        <button type="button"
                            class="oe_stat_button pms-chatter-toggle-btn"
                            icon="fa-comments"
                            title="Toggle Chatter">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Chatter</span>
                            </div>
                        </button>

                        <!-- HR sync button: refreshes competency score rows
                             if the linked competency template was updated
                             after this appraisal was created. -->
                        <button name="action_sync_competency_scores"
                            string="Sync Competency"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-refresh"
                            groups="hr_employee_evaluation.group_pms_hr_manager"
                            invisible="not template_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sync Competency</span>
                            </div>
                        </button>

                        <!-- Adhoc / Extra-Mile button — appraisal phase only -->
                        <button name="action_toggle_adhoc_tab"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-star"
                            invisible="state not in ('appraisal_draft', 'appraisal_pending_supervisor', 'appraisal_pending_secondary_supervisor', 'appraisal_pending_reviewer', 'appraisal_approved')">
                            <field name="adhoc_count" widget="statinfo" string="Adhoc"/>
                        </button>
                    </div>

                    <div class="alert alert-warning"
                        invisible="state != 'appraisal_draft' or not is_own_appraisal or not self_has_zero_scores">
                        <i class="fa fa-exclamation-triangle me-1" />
                        <strong>Warning:</strong> Some
                        KPIs have a score of 0. </div>

                    <!-- ═══ Two-column layout ═══ -->
                    <div class="pms_appraisal_layout" style="display:grid; grid-template-columns:auto 360px; gap:24px; align-items:start; margin-bottom:1.5rem;">

                        <!-- LEFT: Profile + stat cards -->
                        <div>
                            <div class="pms_plan_header">
                                <div class="pms_plan_profile_row">
                                    <field name="employee_id"
                                        widget="many2one_avatar_employee"
                                        readonly="1"
                                        options="{'no_open': True}"
                                        nolabel="1"
                                        class="pms_plan_avatar_field"/>
                                    <div class="pms_plan_profile_info">
                                        <div class="pms_plan_emp_name">
                                            <field name="employee_id" readonly="1" options="{'no_open': True}" nolabel="1" class="pms_emp_name_field"/>
                                        </div>
                                        <div class="pms_plan_meta_row">
                                            <span class="pms_plan_meta_item">
                                                <i class="fa fa-briefcase me-1 text-muted"/>
                                                <field name="employee_job_id" string="Job Position" readonly="1" options="{'no_open': True}" nolabel="1" class="d-inline"/>
                                            </span>
                                            <span class="pms_plan_meta_sep">·</span>
                                            <span class="pms_plan_meta_item">
                                                <i class="fa fa-building me-1 text-muted"/>
                                                <field name="employee_department_id" string="Department" readonly="1" options="{'no_open': True}" nolabel="1" class="d-inline"/>
                                            </span>
                                            <span class="pms_plan_meta_sep">·</span>
                                            <span class="pms_plan_meta_item">
                                                <i class="fa fa-users me-1 text-muted"/>
                                                <field name="employee_evaluation_group_id" string="Evaluation Group" readonly="1" options="{'no_open': True}" nolabel="1" class="d-inline"/>
                                            </span>
                                        </div>
                                        <div class="pms_plan_status_row mt-2">
                                            <field name="state" widget="statusbar"
                                                statusbar_visible="appraisal_draft,appraisal_pending_supervisor,appraisal_pending_secondary_supervisor,appraisal_pending_reviewer,appraisal_approved"
                                                class="pms_inline_statusbar"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="pms_plan_stats_row mt-3">
                                    <div class="pms_plan_stat_card pms_stat_score_alloc">
                                        <div class="pms_stat_label">Total Score</div>
                                        <div class="pms_stat_value">
                                            <field name="allocated_total_score" widget="float" nolabel="1" readonly="1"/>
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_score_current" invisible="not (state in ('appraisal_draft', 'appraisal_pending_supervisor') and can_employee_self_rate)">
                                        <div class="pms_stat_label">Current Total</div>
                                        <div class="pms_stat_value">
                                            <field name="current_total_score" widget="float" nolabel="1" readonly="1"/>
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_score_current" invisible="state != 'appraisal_approved'">
                                        <div class="pms_stat_label">Final Score</div>
                                        <div class="pms_stat_value" style="color:#6c5ecf;">
                                            <field name="final_appraisal_score" widget="float" nolabel="1" readonly="1"/>
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_date_start">
                                        <div class="pms_stat_label">Appraisal Start</div>
                                        <div class="pms_stat_value">
                                            <field name="appraisal_start_date_display" nolabel="1" readonly="1"/>
                                        </div>
                                    </div>
                                    <div class="pms_plan_stat_card pms_stat_date_end">
                                        <div class="pms_stat_label">Appraisal End</div>
                                        <div class="pms_stat_value">
                                            <field name="appraisal_end_date_display" nolabel="1" readonly="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Plan details card -->
                        <div>
                            <div class="pms_details_card">

                                <div class="pms_details_section_title">Appraisal Details</div>
                                
                                <div class="pms_detail_row">
                                    <span class="pms_detail_label">Manager</span>
                                    <div class="pms_detail_value">
                                        <field name="supervisor_id" readonly="1" options="{'no_open': True}" nolabel="1"/>
                                    </div>
                                </div>
                                
                                <div class="pms_detail_row" invisible="not secondary_supervisor_id">
                                    <span class="pms_detail_label">Secondary Manager</span>
                                    <div class="pms_detail_value">
                                        <field name="secondary_supervisor_id" readonly="1" options="{'no_open': True}" nolabel="1"/>
                                    </div>
                                </div>
                                
                                <div class="pms_detail_row" invisible="not reviewer_id">
                                    <span class="pms_detail_label">Reviewer</span>
                                    <div class="pms_detail_value">
                                        <field name="reviewer_id" readonly="1" options="{'no_open': True}" nolabel="1"/>
                                    </div>
                                </div>
                                
                                <div class="pms_detail_row">
                                    <span class="pms_detail_label">Template</span>
                                    <div class="pms_detail_value">
                                        <field name="template_id" readonly="1" options="{'no_open': True}" nolabel="1"/>
                                    </div>
                                </div>
                                
                                <div class="pms_detail_row" invisible="not appraisal_reset_date">
                                    <span class="pms_detail_label">Last Reset By HR</span>
                                    <div class="pms_detail_value">
                                        <field name="appraisal_reset_date" readonly="1" nolabel="1"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- ── Access control flags (invisible) ──────────── -->
                    <field name="is_own_appraisal" invisible="1" />
                    <field name="can_employee_self_rate" invisible="1" />
                    <field name="self_has_zero_scores" invisible="1" />
                    <field name="supervisor_has_zero_scores" invisible="1" />
                    <field name="secondary_supervisor_has_zero_scores" invisible="1" />
                    <field name="reviewer_has_zero_scores" invisible="1" />
                    <field name="can_secondary_supervisor_rate" invisible="1" />
                    <field name="can_reviewer_rate" invisible="1" />
                    <field name="cycle_id" invisible="1" />

                    <!-- ── Competency score rows (invisible data carrier) ─
                         Loads appraisal.competency.score rows into
                         record.data so the KraTabs OWL widget can read
                         and edit them. Every sub-field listed here is
                         accessed by the JS widget — do not remove any.
                    ──────────────────────────────────────────────────── -->
                    <field name="competency_score_ids" invisible="1">
                        <list>
                            <field name="competency_line_id" />
                            <field name="group_id" />
                            <field name="group_name" />
                            <field name="group_hr_code" />
                            <field name="group_sequence" />
                            <field name="line_name" />
                            <field name="line_description" />
                            <field name="line_full_code" />
                            <field name="line_points" />
                            <field name="line_sequence" />
                            <field name="self_score" />
                            <field name="self_remarks" />
                            <field name="supervisor_score" />
                            <field name="supervisor_remarks" />
                            <field name="secondary_supervisor_score" />
                            <field name="secondary_supervisor_remarks" />
                            <field name="reviewer_score" />
                            <field name="reviewer_remarks" />
                        </list>
                    </field>

                    <field name="adhoc_tab_active" invisible="1" />
                    <field name="adhoc_activity_ids" invisible="1">
                        <list>
                            <field name="title"/>
                            <field name="description"/>
                            <field name="completed_date"/>
                            <field name="category"/>
                            <field name="evidence_attachment_ids"/>
                        </list>
                    </field>

                    <!-- ── KRA Tabs Widget ──────────────────────────── -->
                    <field name="kra_ids"
                        widget="kra_tabs_widget"
                        options="{'mode': 'appraisal_employee'}"
                        readonly="not can_employee_self_rate"
                        nolabel="1"
                        class="w-100 d-block">
                        <list>
                            <field name="name" />
                            <field name="evidence_attachment_ids" />
                            <field name="kpi_ids">
                                <list>
                                    <field name="name" />
                                    <field name="description" />
                                    <field name="criteria" />
                                    <field name="weightage" />
                                    <field name="target" />
                                    <field name="is_selected" />
                                    <field name="self_score" />
                                    <field name="self_remarks" />
                                    <field name="supervisor_score" />
                                    <field name="supervisor_remarks" />
                                    <field name="secondary_supervisor_score" />
                                    <field name="secondary_supervisor_score_remarks" />
                                    <field name="reviewer_score" />
                                    <field name="reviewer_remarks" />
                                </list>
                            </field>
                        </list>
                    </field>

                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="action_employee_appraisal" model="ir.actions.act_window">
        <field name="name">My Appraisal</field>
        <field name="res_model">pms.appraisal</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_employee_appraisal_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_employee_appraisal_form')})]" />

        <field name="domain">[
            ('employee_id.user_id', '=', uid),
            ('cycle_id.state', 'in', ['appraisal', 'completed']),
            ('state', 'in', ['appraisal_draft', 'appraisal_pending_supervisor',
            'appraisal_pending_secondary_supervisor',
            'appraisal_pending_reviewer', 'appraisal_approved'])
            ]</field>
        <field name="context">{
            'create': False,
            'delete': False,
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No active appraisal currently.</p>
        </field>
    </record>

</odoo>