<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pms_add_employee_wizard_form" model="ir.ui.view">
        <field name="name">pms.add.employee.wizard.form</field>
        <field name="model">pms.add.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Employees to Cycle">
                <div class="alert alert-info" role="alert">
                    Selected employees will be given a fresh planning window of 
                    <strong><field name="cycle_id" readonly="1" options="{'no_open': True}"/></strong>'s 
                    standard duration starting from today.
                </div>
                <group>
                    <field name="employee_ids" 
                           widget="many2many_tags_avatar" 
                           options="{'no_create': True}" 
                           placeholder="Select employees..."/>
                </group>
                <footer>
                    <button name="action_add_employees" type="object" string="Add Employees" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>