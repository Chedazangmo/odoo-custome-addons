<style t-if="isAppraisalEmployeeMode or isAppraisalSupervisorMode">
                        .appraisal-wrapper {
                            width: 100%;
                            overflow-x: auto;
                            position: relative;
                            padding-bottom: 12px;
                            background-color: #fff;
                        }

                        /* Flexbox Structure */
                        .appraisal-flex-table {
                            display: flex;
                            flex-direction: column;
                            width: 100%;
                            border: none !important;
                            background-color: #fff;
                        }
                        
                        .appraisal-flex-table thead, .appraisal-flex-table tbody {
                            display: flex;
                            flex-direction: column;
                            width: 100%;
                        }
                        
                        /* MAGIC TRICK: Setting tr width to exactly 100% tells the browser to calculate 
                           percentages based on the form sheet! */
                        .appraisal-flex-table tr {
                            display: flex;
                            flex-wrap: nowrap;
                            width: 100%; 
                            border: none !important;
                        }
                        
                        /* MAGIC TRICK 2: flex-shrink: 0 prevents the browser from squishing the fields. 
                           It forces the extra fields to overflow into a beautiful scrollbar! */
                        .appraisal-flex-table th, .appraisal-flex-table td {
                            flex-shrink: 0; 
                            border: none !important;
                            padding: 8px;
                            background-color: #fff;
                            box-sizing: border-box;
                        }

                        /* EXACT PERCENTAGES AS REQUESTED (Summing to 100%) 
                           min-width added so they don't break if you shrink your browser heavily */
                        .col-kpi { width: 16%; min-width: 140px; } 
                        .col-sco { width: 10%; min-width: 70px;  } 
                        .col-cri { width: 23%; min-width: 180px; } 
                        .col-tar { width: 23%; min-width: 180px; } 
                        .col-ssc { width: 13%; min-width: 110px; } 
                        .col-srm { width: 15%; min-width: 130px; } 
                        
                        /* Scrolling Ratings/Remarks columns (Uniform with Self) */
                        .col-msc { width: 13%; min-width: 110px; } 
                        .col-mrm { width: 15%; min-width: 130px; } 

                        /* FROZEN COLUMNS (Totally Opaque) 
                           Offsets dynamically match the percentages! */
                        .s-1 { position: sticky !important; left: 0%;    z-index: 10 !important; background-color: #fff !important; }
                        .s-2 { position: sticky !important; left: 16%;   z-index: 10 !important; background-color: #fff !important; }
                        .s-3 { position: sticky !important; left: 26%;   z-index: 10 !important; background-color: #fff !important; } 
                        .s-4 { position: sticky !important; left: 49%;   z-index: 10 !important; background-color: #fff !important; }  
                        
                        /* Header Styling */
                        .appraisal-flex-table thead th {
                            position: sticky;
                            top: 0;
                            z-index: 11 !important;
                            background-color: #f8f9fa !important;
                            color: #495057;
                            font-weight: 600;
                            text-transform: uppercase;
                            font-size: 12px;
                            border-bottom: 2px solid #dee2e6 !important;
                        }
                        
                        .appraisal-flex-table thead th.s-1,
                        .appraisal-flex-table thead th.s-2,
                        .appraisal-flex-table thead th.s-3,
                        .appraisal-flex-table thead th.s-4 {
                            z-index: 12 !important;
                            background-color: #f8f9fa !important;
                        }

                        /* Clean Textareas */
                        .appraisal-flex-table input.form-control,
                        .appraisal-flex-table textarea.form-control {
                            border: none;
                            background: transparent;
                            padding: 4px 6px;
                            box-shadow: none;
                            resize: none;
                            font-size: 0.85rem;
                            min-height: 32px;
                        }
                        .appraisal-flex-table textarea.form-control:focus,
                        .appraisal-flex-table input.form-control:focus {
                            background: #f8f9fa;
                            border-bottom: 1px solid #004D8B;
                            outline: none;
                        }

                        /* Custom Scrollbar */
                        .appraisal-wrapper::-webkit-scrollbar { height: 10px; }
                        .appraisal-wrapper::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
                        .appraisal-wrapper::-webkit-scrollbar-thumb { background: #c1c1c1; border-radius: 4px; }
                        .appraisal-wrapper::-webkit-scrollbar-thumb:hover { background: #a8a8a8; }
                    </style>

                    <div class="text-muted small text-end mb-2" t-if="isAppraisalEmployeeMode or isAppraisalSupervisorMode">
                        <i class="fa fa-arrows-h me-1"/> Scroll horizontally for more scores
                    </div>

                    <div class="appraisal-wrapper" t-if="isAppraisalEmployeeMode">
                        <div class="appraisal-flex-table">
                            <thead>
                                <tr>
                                    <th class="s-1 col-kpi">KPI Name</th>
                                    <th class="s-2 col-sco">Score</th>
                                    <th class="s-3 col-cri">Criteria</th>
                                    <th class="s-4 col-tar">Target</th>
                                    
                                    <th class="col-ssc">Emp Score</th>
                                    <th class="col-srm">Emp Remarks</th>
                                    
                                    <th class="col-msc">Sup Score</th>
                                    <th class="col-mrm">Sup Remarks</th>
                                    <th t-if="props.record.data.secondary_supervisor_id" class="col-msc">2nd Sup Score</th>
                                    <th t-if="props.record.data.secondary_supervisor_id" class="col-mrm">2nd Sup Remarks</th>
                                    <th t-if="props.record.data.reviewer_id" class="col-msc">Rev Score</th>
                                    <th t-if="props.record.data.reviewer_id" class="col-mrm">Rev Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="activeKPIs.length === 0">
                                    <tr><td colspan="12" class="text-center text-muted py-5" style="width: 100%;"><em>No KPIs in this KRA.</em></td></tr>
                                </t>
                                <t t-foreach="activeKPIs" t-as="kpi" t-key="kpi.id">
                                    <tr t-if="kpi.data.is_selected">
                                        <td class="s-1 col-kpi"><textarea class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.name"/></td>
                                        <td class="s-2 col-sco"><input type="number" class="form-control text-end" t-att-value="kpi.data.weightage" readonly="1"/></td>
                                        <td class="s-3 col-cri"><textarea class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.criteria"/></td>
                                        <td class="s-4 col-tar"><textarea class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.target"/></td>
                                        
                                        <td class="col-ssc">
                                            <input t-if="!props.readonly and props.record.data.can_employee_self_rate" type="number" min="0" t-att-max="kpi.data.weightage" class="form-control text-end" t-att-value="kpi.data.self_score" t-on-change="(ev) => this.onKPIFieldChange(kpi, 'self_score', ev)"/>
                                            <input t-else="" type="number" class="form-control text-end" t-att-value="kpi.data.self_score" readonly="1"/>
                                        </td>
                                        <td class="col-srm">
                                            <textarea t-if="!props.readonly and props.record.data.can_employee_self_rate" class="form-control" rows="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-att-value="kpi.data.self_remarks" t-on-change="(ev) => this.onKPIFieldChange(kpi, 'self_remarks', ev)"/>
                                            <textarea t-else="" class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.self_remarks"/>
                                        </td>

                                        <td class="col-msc"><input type="number" class="form-control text-end" t-att-value="kpi.data.supervisor_score" readonly="1"/></td>
                                        <td class="col-mrm"><textarea class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.supervisor_remarks"/></td>
                                        
                                        <t t-if="props.record.data.secondary_supervisor_id">
                                            <td class="col-msc"><input type="number" class="form-control text-end" t-att-value="kpi.data.secondary_supervisor_score" readonly="1"/></td>
                                            <td class="col-mrm"><textarea class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.secondary_supervisor_score_remarks"/></td>
                                        </t>
                                        
                                        <t t-if="props.record.data.reviewer_id">
                                            <td class="col-msc"><input type="number" class="form-control text-end" t-att-value="kpi.data.reviewer_score" readonly="1"/></td>
                                            <td class="col-mrm"><textarea class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.reviewer_remarks"/></td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </div>
                    </div>

                    <div class="appraisal-wrapper" t-if="isAppraisalSupervisorMode">
                        <div class="appraisal-flex-table">
                            <thead>
                                <tr>
                                    <th class="s-1 col-kpi">KPI Name</th>
                                    <th class="s-2 col-sco">Score</th>
                                    <th class="s-3 col-cri">Criteria</th>
                                    <th class="s-4 col-tar">Target</th>
                                    
                                    <th class="col-ssc">Emp Score</th>
                                    <th class="col-srm">Emp Remarks</th>
                                    
                                    <th class="col-msc">Sup Score</th>
                                    <th class="col-mrm">Sup Remarks</th>
                                    <th t-if="props.record.data.secondary_supervisor_id" class="col-msc">2nd Sup Score</th>
                                    <th t-if="props.record.data.secondary_supervisor_id" class="col-mrm">2nd Sup Remarks</th>
                                    <th t-if="props.record.data.reviewer_id" class="col-msc">Rev Score</th>
                                    <th t-if="props.record.data.reviewer_id" class="col-mrm">Rev Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="activeKPIs.length === 0">
                                    <tr><td colspan="12" class="text-center text-muted py-5" style="width: 100%;"><em>No KPIs in this KRA.</em></td></tr>
                                </t>
                                <t t-foreach="activeKPIs" t-as="kpi" t-key="kpi.id">
                                    <tr t-if="kpi.data.is_selected">
                                        <td class="s-1 col-kpi"><textarea class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.name"/></td>
                                        <td class="s-2 col-sco"><input type="number" class="form-control text-end" t-att-value="kpi.data.weightage" readonly="1"/></td>
                                        <td class="s-3 col-cri"><textarea class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.criteria"/></td>
                                        <td class="s-4 col-tar"><textarea class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.target"/></td>
                                        
                                        <td class="col-ssc"><input type="number" class="form-control text-end" t-att-value="kpi.data.self_score" readonly="1"/></td>
                                        <td class="col-srm"><textarea class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.self_remarks"/></td>

                                        <td class="col-msc">
                                            <input t-if="!props.readonly and props.record.data.can_supervisor_rate" type="number" min="0" t-att-max="kpi.data.weightage" class="form-control text-end" t-att-value="kpi.data.supervisor_score" t-on-change="(ev) => this.onKPIFieldChange(kpi, 'supervisor_score', ev)"/>
                                            <input t-else="" type="number" class="form-control text-end" t-att-value="kpi.data.supervisor_score" readonly="1"/>
                                        </td>
                                        <td class="col-mrm">
                                            <textarea t-if="!props.readonly and props.record.data.can_supervisor_rate" class="form-control" rows="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-att-value="kpi.data.supervisor_remarks" t-on-change="(ev) => this.onKPIFieldChange(kpi, 'supervisor_remarks', ev)"/>
                                            <textarea t-else="" class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.supervisor_remarks"/>
                                        </td>

                                        <t t-if="props.record.data.secondary_supervisor_id">
                                            <td class="col-msc">
                                                <input t-if="!props.readonly and props.record.data.can_secondary_supervisor_rate" type="number" min="0" t-att-max="kpi.data.weightage" class="form-control text-end" t-att-value="kpi.data.secondary_supervisor_score" t-on-change="(ev) => this.onKPIFieldChange(kpi, 'secondary_supervisor_score', ev)"/>
                                                <input t-else="" type="number" class="form-control text-end" t-att-value="kpi.data.secondary_supervisor_score" readonly="1"/>
                                            </td>
                                            <td class="col-mrm">
                                                <textarea t-if="!props.readonly and props.record.data.can_secondary_supervisor_rate" class="form-control" rows="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-att-value="kpi.data.secondary_supervisor_score_remarks" t-on-change="(ev) => this.onKPIFieldChange(kpi, 'secondary_supervisor_score_remarks', ev)"/>
                                                <textarea t-else="" class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.secondary_supervisor_score_remarks"/>
                                            </td>
                                        </t>
                                        
                                        <t t-if="props.record.data.reviewer_id">
                                            <td class="col-msc">
                                                <input t-if="!props.readonly and props.record.data.can_reviewer_rate" type="number" min="0" t-att-max="kpi.data.weightage" class="form-control text-end" t-att-value="kpi.data.reviewer_score" t-on-change="(ev) => this.onKPIFieldChange(kpi, 'reviewer_score', ev)"/>
                                                <input t-else="" type="number" class="form-control text-end" t-att-value="kpi.data.reviewer_score" readonly="1"/>
                                            </td>
                                            <td class="col-mrm">
                                                <textarea t-if="!props.readonly and props.record.data.can_reviewer_rate" class="form-control" rows="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-att-value="kpi.data.reviewer_remarks" t-on-change="(ev) => this.onKPIFieldChange(kpi, 'reviewer_remarks', ev)"/>
                                                <textarea t-else="" class="form-control" rows="1" readonly="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'" t-esc="kpi.data.reviewer_remarks"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </div>
                    </div>


